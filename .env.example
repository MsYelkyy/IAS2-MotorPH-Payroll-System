# =============================================================================
# MotorPH Payroll System - Docker environment template
# -----------------------------------------------------------------------------
# docker compose reads the .env file next to docker-compose.yml.
#
#   cp .env.example .env      (Git Bash / macOS / Linux)
#   copy .env.example .env    (Windows cmd)
#
# Then replace EVERY placeholder below with a real value. .env is gitignored and
# must never be committed. This template contains placeholders only.
#
# Note: docker compose treats "$" in a value as a variable reference. Avoid "$"
# in passwords, or write it as "$$".
# =============================================================================

# --- MySQL ------------------------------------------------------------------

# Administrative account inside the MySQL container. The backend never uses it.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Host port for direct database access (MySQL Workbench, the report SQL
# scripts). Published on 127.0.0.1 only. 3307 avoids clashing with a MySQL 8
# already installed on the host, which usually owns 3306.
MYSQL_LOCAL_PORT=3307


# --- Backend database account ------------------------------------------------
# Created on first start by docker/mysql/init/05-create-backend-user.sh with the
# grants documented in README.md: SELECT, INSERT, UPDATE, DELETE on
# payrollsystem_db only. No DDL, no GRANT OPTION, no other schemas.

MOTORPH_DB_USER=motorph_backend
MOTORPH_DB_PASSWORD=replace-with-a-strong-database-password

# Host scope for that account. Matches the compose network subnet declared in
# docker-compose.yml, so the account cannot be used from outside it. Change both
# together if the 172.28.0.0/16 range clashes on your machine.
MOTORPH_DB_CLIENT_HOST=172.28.%


# --- Backend -----------------------------------------------------------------

# Host port for the REST API. The desktop client expects 8080.
BACKEND_LOCAL_PORT=8080

MOTORPH_PROFILE=default

# 32+ bytes of randomness. The backend refuses to start if this is missing or
# too short. Generate one with:  openssl rand -base64 48
MOTORPH_JWT_SECRET=replace-with-a-long-random-signing-secret
MOTORPH_JWT_ACCESS_EXPIRY_MINUTES=15
MOTORPH_JWT_REFRESH_EXPIRY_MINUTES=1440


# --- Shared ------------------------------------------------------------------

# Applied to both containers so timestamps match the host-run setup.
TZ=Asia/Manila
