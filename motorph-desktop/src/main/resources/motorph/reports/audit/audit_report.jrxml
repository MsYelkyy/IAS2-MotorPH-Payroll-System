<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="audit_report" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="b1c2d3e4-2222-4444-9555-bcde23456789">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="START_DATE" class="java.time.LocalDate"/>
    <parameter name="END_DATE" class="java.time.LocalDate"/>


    <field name="logId" class="java.lang.Integer"/>
    <field name="userAccountId" class="java.lang.Integer"/>
    <field name="companyEmail" class="java.lang.String"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="action" class="java.lang.String"/>
    <field name="details" class="java.lang.String"/>
    <field name="ipAddress" class="java.lang.String"/>
    <field name="deviceInfo" class="java.lang.String"/>
    <field name="loggedAt" class="java.time.LocalDateTime"/>


    <variable name="recordCount" calculation="Count" class="java.lang.Integer">
        <expression><![CDATA[$F{logId}]]></expression>
    </variable>


    <title height="170">
        <element kind="image" uuid="11111111-aaaa-4111-8111-111111111111" x="0" y="12" width="115" height="98">
