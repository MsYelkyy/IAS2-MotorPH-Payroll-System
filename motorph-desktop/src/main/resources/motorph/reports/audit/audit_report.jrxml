        <element kind="textField" uuid="88888888-aaaa-4888-8888-888888888888" x="0" y="153" width="535" height="12" forecolor="#000000" fontSize="8.0" bold="true" hTextAlign="Center">
            <expression><![CDATA[($P{START_DATE} == null || $P{END_DATE} == null)
