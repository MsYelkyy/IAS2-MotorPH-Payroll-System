<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.support.SupportTicketController">

    <HBox styleClass="hero">
        <VBox styleClass="hero-text" HBox.hgrow="ALWAYS">
            <Label text="EMPLOYEE SUPPORT" styleClass="hero-kicker"/>
            <Label text="Review and respond to support requests" styleClass="hero-title"/>
            <Label text="Track requests from submission through resolution." styleClass="hero-note"/>
        </VBox>
        <Button text="Refresh tickets" onAction="#handleRefresh" styleClass="primary-button"/>
    </HBox>

    <GridPane hgap="13" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
        </columnConstraints>
        <VBox styleClass="stat-card, stat-primary" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0">
            <Label text="OPEN TICKETS" styleClass="stat-kicker"/>
            <Label fx:id="openTicketsLabel" text="0" styleClass="stat-value"/>
            <Label text="Awaiting resolution" styleClass="stat-note"/>
        </VBox>
        <VBox styleClass="stat-card, stat-teal" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1">
            <Label text="RESOLVED TICKETS" styleClass="stat-kicker"/>
            <Label fx:id="resolvedTicketsLabel" text="0" styleClass="stat-value"/>
            <Label text="Successfully resolved" styleClass="stat-note"/>
        </VBox>
        <VBox styleClass="stat-card, stat-gray" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2">
            <Label text="CANCELLED TICKETS" styleClass="stat-kicker"/>
            <Label fx:id="cancelledTicketsLabel" text="0" styleClass="stat-value"/>
            <Label text="Cancelled tickets" styleClass="stat-note"/>
        </VBox>
        <VBox styleClass="stat-card, stat-navy" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="3">
            <Label text="TOTAL TICKETS" styleClass="stat-kicker"/>
            <Label fx:id="totalTicketsLabel" text="0" styleClass="stat-value"/>
            <Label text="All time tickets" styleClass="stat-note"/>
        </VBox>
    </GridPane>

    <VBox styleClass="panel" VBox.vgrow="ALWAYS">

        <HBox styleClass="ticket-filters" alignment="BOTTOM_LEFT">
            <HBox fx:id="tabsRow" spacing="5" alignment="BOTTOM_LEFT"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="6" prefWidth="360">
                <Label text="SEARCH" styleClass="ticket-field-label"/>
                <TextField fx:id="searchField" promptText="Search by ticket ID, employee, or title"
                           maxWidth="Infinity" styleClass="ticket-filter-input"/>
            </VBox>
            <VBox spacing="6" prefWidth="150">
                <Label text="CATEGORY" styleClass="ticket-field-label"/>
                <ComboBox fx:id="categoryFilterCombo" maxWidth="Infinity" styleClass="ticket-filter-input"/>
            </VBox>
        </HBox>

        <VBox styleClass="ticket-list" VBox.vgrow="ALWAYS">
            <VBox styleClass="ticket-list-head">
                <Label text="Tickets list" styleClass="ticket-list-title"/>
                <Label text="Employee requests requiring review" styleClass="ticket-list-note"/>
            </VBox>

            <TableView fx:id="ticketsTable" VBox.vgrow="ALWAYS"
                       minHeight="200" prefHeight="200" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="ticketIdColumn"  text="TICKET ID"      prefWidth="120" minWidth="80"/>
                    <TableColumn fx:id="employeeColumn"  text="EMPLOYEE"        prefWidth="160" minWidth="110"/>
                    <TableColumn fx:id="categoryColumn"  text="CATEGORY"        prefWidth="165" minWidth="100"/>
                    <TableColumn fx:id="subjectColumn"   text="TITLE / SUBJECT" prefWidth="245" minWidth="140"/>
                    <TableColumn fx:id="statusColumn"    text="STATUS"          prefWidth="105" minWidth="80"/>
                    <TableColumn fx:id="createdAtColumn" text="DATE CREATED"    prefWidth="200" minWidth="130"/>
                    <TableColumn fx:id="viewColumn"      text=""                prefWidth="100" minWidth="70"/>
                </columns>
            </TableView>
        </VBox>

        <HBox styleClass="table-pager">
            <Label fx:id="ticketsPageLabel" text="Page 1 of 1" styleClass="pager-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="ticketsRecordInfoLabel" text="" styleClass="pager-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="ticketsPrevButton" text="Previous" onAction="#handleTicketsPrevPage" styleClass="pager-button"/>
            <Button fx:id="ticketsNextButton" text="Next" onAction="#handleTicketsNextPage" styleClass="pager-button"/>
        </HBox>
    </VBox>

    <!-- toast anchor; messages appear as toasts, never in the layout -->
    <Label fx:id="messageLabel" visible="false" managed="false"/>

</VBox>
