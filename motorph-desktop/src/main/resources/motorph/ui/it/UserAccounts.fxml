<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  IT-owned User Access Management.
  Mirrors the Admin User Account pattern (toolbar + master-detail + role
  assignment) but stays under it/ and uses ITUserAccountController.
-->
<VBox spacing="16"
      styleClass="user-accounts-view"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.it.ITUserAccountController">

    <!-- Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by email or employee ID..."
                   styleClass="input-field" prefWidth="320" maxWidth="480" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="filterCombo" promptText="Filter" styleClass="input-field"
                  prefWidth="150" minWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text" wrapText="true" maxWidth="300"/>
    </HBox>

    <!-- Main content: list + optional detail panel -->
    <HBox spacing="16" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

        <!-- Account list -->
        <VBox styleClass="content-card" spacing="0" HBox.hgrow="ALWAYS">
            <TableView fx:id="accountTable" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="accountIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                    <TableColumn fx:id="employeeIdColumn" text="EMP ID" prefWidth="90" minWidth="70"/>
                    <TableColumn fx:id="emailColumn" text="COMPANY EMAIL" prefWidth="260" minWidth="190"/>
                    <TableColumn fx:id="rolesColumn" text="ROLES" prefWidth="180" minWidth="130"/>
                    <TableColumn fx:id="statusColumn" text="STATUS" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="actionColumn" text="ACTIONS" prefWidth="120" minWidth="100"/>
                </columns>
                <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No user accounts found" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Detail panel (shown when a row is managed) -->
        <VBox fx:id="detailPanel" styleClass="content-card" prefWidth="300" minWidth="300"
              spacing="10" visible="false" managed="false">

            <Label text="ACCOUNT DETAILS" styleClass="section-title"/>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <VBox spacing="2">
                    <Label text="COMPANY EMAIL" styleClass="field-label"/>
                    <Label fx:id="detailEmailLabel" text="—" styleClass="data-line" wrapText="true"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="EMPLOYEE ID" styleClass="field-label"/>
                    <Label fx:id="detailEmployeeIdLabel" text="—" styleClass="data-line"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="STATUS" styleClass="field-label"/>
                    <Label fx:id="detailStatusLabel" text="—" styleClass="data-line"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="LOCKED" styleClass="field-label"/>
                    <Label fx:id="detailLockedLabel" text="—" styleClass="data-line"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="LAST LOGIN" styleClass="field-label"/>
                    <Label fx:id="detailLastLoginLabel" text="—" styleClass="data-line"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="CURRENT ROLES" styleClass="field-label"/>
                    <Label fx:id="detailRolesLabel" text="—" styleClass="data-line" wrapText="true"/>
                </VBox>

                <!-- Role assignment -->
                <VBox fx:id="roleAssignmentSection" spacing="6" style="-fx-padding: 8 0 0 0;">
                    <Label text="ASSIGN ROLES" styleClass="field-label"/>
                    <CheckBox fx:id="roleAdminCheck"    text="ADMIN"    styleClass="data-line"/>
                    <CheckBox fx:id="roleHrCheck"       text="HR"       styleClass="data-line"/>
                    <CheckBox fx:id="roleFinanceCheck"  text="FINANCE"  styleClass="data-line"/>
                    <CheckBox fx:id="roleItCheck"       text="IT"       styleClass="data-line"/>
                    <CheckBox fx:id="roleEmployeeCheck" text="EMPLOYEE" styleClass="data-line"/>
                    <Button fx:id="saveRolesButton" text="Save Roles" onAction="#handleSaveRoles"
                            styleClass="primary-button" maxWidth="Infinity"
                            style="-fx-padding: 6 12;"/>
                </VBox>
            </VBox>

            <!-- Status action buttons -->
            <VBox spacing="8">
                <Button fx:id="lockButton" text="Lock Account" onAction="#handleToggleLock"
                        styleClass="danger-outline-button" maxWidth="Infinity"/>
                <Button fx:id="enableButton" text="Disable Account" onAction="#handleToggleEnable"
                        styleClass="danger-outline-button" maxWidth="Infinity"/>
                <Button fx:id="resetTotpButton" text="Reset Authenticator" onAction="#handleResetTotp"
                        styleClass="secondary-button" maxWidth="Infinity" visible="false" managed="false"/>
                <Button text="Close" onAction="#handleCloseDetail"
                        styleClass="secondary-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>

    </HBox>

</VBox>
