<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.it.PasswordResetRequestController">

    <HBox spacing="14" minHeight="-Infinity">
        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="PENDING REQUESTS" styleClass="metric-label"/>
            <Label fx:id="pendingRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Awaiting your action" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="COMPLETED REQUESTS" styleClass="metric-label"/>
            <Label fx:id="completedRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Successfully processed" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="CANCELLED REQUESTS" styleClass="metric-label"/>
            <Label fx:id="cancelledRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Cancelled by IT" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL REQUESTS" styleClass="metric-label"/>
            <Label fx:id="totalRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="All time requests" styleClass="muted-text"/>
        </VBox>
    </HBox>

    <VBox spacing="12" styleClass="content-card">
        <HBox alignment="BOTTOM_LEFT" spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Search" styleClass="metric-label"/>
                <TextField fx:id="searchField"
                           promptText="Search by employee name, company email, or request ID"
                           maxWidth="Infinity"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Status" styleClass="metric-label"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="170" styleClass="input-field"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="primary-button"/>
        </HBox>

        <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

    <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          styleClass="content-card, attendance-history-card, table-card"
          VBox.vgrow="ALWAYS">

        <VBox spacing="4">
            <Label text="Requests List" styleClass="section-title"/>
            
        </VBox>

        <Region minHeight="16" prefHeight="16"/>

        <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="requestIdColumn"    text="REQUEST ID"   prefWidth="90"  minWidth="70"/>
                <TableColumn fx:id="employeeColumn"     text="EMPLOYEE"     prefWidth="150" minWidth="110"/>
                <TableColumn fx:id="companyEmailColumn" text="COMPANY EMAIL" prefWidth="210" minWidth="140"/>
                <TableColumn fx:id="statusColumn"       text="STATUS"       prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="requestedAtColumn"  text="REQUESTED AT" prefWidth="165" minWidth="120"/>
                <TableColumn fx:id="resolvedByColumn"   text="RESOLVED BY"  prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="completedAtColumn"  text="COMPLETED AT" prefWidth="165" minWidth="120"/>
                <TableColumn fx:id="actionsColumn"      text="ACTIONS"      prefWidth="180" minWidth="130"/>
            </columns>
            <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No password reset requests found" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
        </TableView>

        <Region minHeight="14" prefHeight="14"/>

        <HBox styleClass="table-pager">
            <VBox.margin><Insets left="-19" right="-19"/></VBox.margin>
            <Label fx:id="resetsPageLabel" text="Page 1 of 1" styleClass="pager-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="resetsRecordInfoLabel" text="" styleClass="pager-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="resetsPrevButton" text="Previous" onAction="#handleResetsPrevPage" styleClass="pager-button"/>
            <Button fx:id="resetsNextButton" text="Next" onAction="#handleResetsNextPage" styleClass="pager-button"/>
        </HBox>

    </VBox>

</VBox>
