<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      styleClass="admin-dashboard-view"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.admin.AdminDashboardController">

    <VBox spacing="12">
        <Label text="PEOPLE" styleClass="section-heading"/>
        <GridPane hgap="12" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox styleClass="stat-card, stat-blue" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0">
                <Label text="ACTIVE EMPLOYEES" styleClass="stat-kicker"/>
                <Label fx:id="totalActiveEmployeesLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Currently employed" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-blue" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1">
                <Label text="TOTAL EMPLOYEES" styleClass="stat-kicker"/>
                <Label fx:id="totalAllEmployeesLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Including inactive" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-blue" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2">
                <Label text="ON LEAVE TODAY" styleClass="stat-kicker"/>
                <Label fx:id="onLeaveTodayLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Approved leave today" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-blue" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="3">
                <Label text="PENDING LEAVE" styleClass="stat-kicker"/>
                <Label fx:id="pendingLeaveLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Awaiting approval" styleClass="stat-note"/>
            </VBox>
        </GridPane>
    </VBox>

    <VBox spacing="12">
        <Label text="ACCOUNTS &amp; SECURITY" styleClass="section-heading"/>
        <GridPane hgap="12" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" minWidth="0" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox styleClass="stat-card, stat-teal" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0">
                <Label text="ACTIVE ACCOUNTS" styleClass="stat-kicker"/>
                <Label fx:id="activeAccountsLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Unlocked active users" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-orange" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1">
                <Label text="LOCKED ACCOUNTS" styleClass="stat-kicker"/>
                <Label fx:id="lockedAccountsLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Accounts locked" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-cyan" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2">
                <Label text="DISABLED ACCOUNTS" styleClass="stat-kicker"/>
                <Label fx:id="disabledAccountsLabel" text="&#8212;" styleClass="stat-value"/>
                <Label text="Inactive accounts" styleClass="stat-note"/>
            </VBox>
            <VBox styleClass="stat-card, stat-red" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="3">
                <Label text="LOGIN ACTIVITY (TODAY)" styleClass="stat-kicker"/>
                <HBox styleClass="stat-pair">
                    <VBox styleClass="stat-pair-item">
                        <Label fx:id="successLoginsLabel" text="&#8212;" styleClass="stat-value"/>
                        <Label text="Successful" styleClass="stat-note"/>
                    </VBox>
                    <VBox styleClass="stat-pair-item">
                        <Label fx:id="failedLoginsLabel" text="&#8212;" styleClass="stat-value, stat-value-danger"/>
                        <Label text="Failed" styleClass="stat-note"/>
                    </VBox>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>

    <VBox styleClass="panel, admin-activity" maxWidth="Infinity">
        <Label text="RECENT SYSTEM ACTIVITY" styleClass="section-heading"/>

        <VBox>
            <HBox styleClass="admin-activity-head">
                <Label text="ACTION" styleClass="admin-activity-head-label" minWidth="196" prefWidth="196" maxWidth="196"/>
                <Label text="DETAILS" styleClass="admin-activity-head-label" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Label text="TIMESTAMP" styleClass="admin-activity-head-label" minWidth="180" prefWidth="180" maxWidth="180"/>
            </HBox>
            <VBox fx:id="activityRows"/>
        </VBox>
    </VBox>

</VBox>
