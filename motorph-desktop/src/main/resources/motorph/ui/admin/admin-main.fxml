<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           styleClass="root-canvas, workspace-shell"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.admin.AdminMainController"
           stylesheets="@../../../css/core/base.css, @../../../css/core/shell.css, @../../../css/core/sidebar.css, @../../../css/core/cards.css, @../../../css/core/controls.css, @../../../css/core/table.css, @../../../css/core/feedback.css, @../../../css/modules/shared/shared-components.css, @../../../css/modules/shared/support-ticket.css, @../../../css/modules/reports/reports.css, @../../../css/modules/admin/dashboard.css, @../../../css/modules/hr/employee-management.css, @../../../css/modules/it/user-access-logs.css, @../../../css/core/utilities.css">

    <BorderPane styleClass="app-shell">

        <!-- LEFT: Sidebar -->
        <left>
            <VBox styleClass="sidebar">

                <VBox styleClass="sidebar-brand">
                    <Label text="MotorPH" styleClass="sidebar-brand-name"/>
                    <Label text="PAYROLL MANAGEMENT SYSTEM" styleClass="sidebar-brand-system"/>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            focusTraversable="false" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox styleClass="sidebar-nav">
                            <Label text="ADMIN WORKSPACE" styleClass="sidebar-section"/>
                            <Button fx:id="dashboardNavButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button, selected-nav">
                                <graphic><fx:include source="../../../icons/navigation/grid.fxml"/></graphic>
                            </Button>
                            <Button fx:id="employeesNavButton" text="Employee Management" onAction="#showEmployees" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/user.fxml"/></graphic>
                            </Button>
                            <Button fx:id="payrollNavButton" text="Payroll" onAction="#showPayroll" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/card.fxml"/></graphic>
                            </Button>
                            <Button fx:id="salaryNavButton" text="Salary &amp; Benefits" onAction="#showSalary" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/card.fxml"/></graphic>
                            </Button>
                            <Button fx:id="reportsNavButton" text="Reports" onAction="#showReports" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/chart.fxml"/></graphic>
                            </Button>
                            <Button fx:id="leaveOvertimeNavButton" text="Leave &amp; Overtime" onAction="#showLeaveOvertime" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/calendar-check.fxml"/></graphic>
                            </Button>
                            <Label text="SYSTEM ADMINISTRATION" styleClass="sidebar-section"/>
                            <Button fx:id="userManagementNavButton" text="User Management" onAction="#showUserManagement" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/user.fxml"/></graphic>
                            </Button>
                            <Button fx:id="roleManagementNavButton" text="Role Management" onAction="#showRoleManagement" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/shield.fxml"/></graphic>
                            </Button>
                            <Button fx:id="accessLogsNavButton" text="Access Logs" onAction="#showAccessLogs" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/file.fxml"/></graphic>
                            </Button>
                            <Button fx:id="databaseToolsNavButton" text="Database Backup" onAction="#showDatabaseTools" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/database.fxml"/></graphic>
                            </Button>
                            <Button fx:id="settingsNavButton" text="Settings" onAction="#showSettings" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/gear.fxml"/></graphic>
                            </Button>
                            <Label text="ACCOUNT &amp; SUPPORT" styleClass="sidebar-section"/>
                            <Button fx:id="supportTicketsNavButton" text="Support Tickets" onAction="#showSupportTickets" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/headset.fxml"/></graphic>
                            </Button>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox styleClass="sidebar-footer">
                    <VBox styleClass="sidebar-card">
                        <Label text="SIGNED IN AS" styleClass="sidebar-card-kicker"/>
                        <Label fx:id="employeeNameLabel" text="-" wrapText="true" styleClass="sidebar-card-title"/>
                        <Label fx:id="employeeRoleLabel" text="ADMIN" styleClass="sidebar-card-copy"/>
                    </VBox>
                    <Button fx:id="switchRoleButton" text="Switch role" onAction="#handleSwitchRole"
                            visible="false" managed="false" maxWidth="Infinity" styleClass="sidebar-action"/>
                    <Button text="Log out" onAction="#handleLogout" maxWidth="Infinity" styleClass="sidebar-action, sidebar-logout"/>
                </VBox>

            </VBox>
        </left>

        <!-- CENTER: Main workspace -->
        <center>
            <VBox styleClass="app-main">

                <!-- Topbar -->
                <HBox styleClass="topbar" alignment="CENTER_LEFT">
                    <VBox styleClass="topbar-titles">
                        <Label fx:id="pageSubtitleLabel" text="ADMIN CONTROL PANEL" styleClass="page-subtitle"/>
                        <Label fx:id="pageTitleLabel"    text="Dashboard"           styleClass="page-title"/>
                    </VBox>
                </HBox>

                <!-- Scrollable content area -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="workspace-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane styleClass="content-area">
                            <fx:include fx:id="dashboardView"  source="Dashboard.fxml"/>
                            <fx:include fx:id="employeeView"   source="../hr/EmployeeManagement.fxml" visible="false" managed="false"/>
                            <fx:include fx:id="payrollView"    source="../finance/PayrollManagement.fxml" visible="false" managed="false"/>
                            <fx:include fx:id="salaryView"       source="Salary.fxml"                    visible="false" managed="false"/>
                            <fx:include fx:id="userAccountView" source="../it/UserAccounts.fxml"                   visible="false" managed="false"/>
                            <fx:include fx:id="rolesView"       source="../it/RoleManagement.fxml"                 visible="false" managed="false"/>
                            <fx:include fx:id="accessLogsView"  source="../it/UserAccessLogs.fxml"                visible="false" managed="false"/>
                            <fx:include fx:id="reportsView"     source="../reports/reports.fxml"                    visible="false" managed="false"/>
                            <fx:include fx:id="leaveView"       source="../hr/LeaveManagement.fxml"                   visible="false" managed="false"/>
                            <fx:include fx:id="systemConfigView"    source="SystemConfig.fxml"           visible="false" managed="false"/>
                            <fx:include fx:id="databaseToolsView"  source="DatabaseTools.fxml"          visible="false" managed="false"/>
                            <fx:include fx:id="supportTicketsView" source="../support/SupportTickets.fxml"         visible="false" managed="false"/>
                            <VBox fx:id="modulePlaceholder" alignment="CENTER" spacing="12"
                                  visible="false" managed="false">
                                <Label text="Coming Soon" styleClass="page-title"/>
                                <Label text="This module is under construction." styleClass="muted-text"/>
                            </VBox>
                        </StackPane>
                    </content>
                </ScrollPane>

            </VBox>
        </center>

    </BorderPane>

</StackPane>
