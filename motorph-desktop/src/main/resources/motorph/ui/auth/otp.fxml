<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22" styleClass="form-card"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.OtpController">
    <Label text="TWO-FACTOR AUTHENTICATION" styleClass="form-eyebrow"/>
    <VBox spacing="12">
        <Label text="Verify your identity" styleClass="form-heading"/>
        <Label text="Enter the verification code sent to your registered email address."
               wrapText="true" styleClass="form-subheading"/>
    </VBox>
    <VBox spacing="9">
        <Label text="Verification code" styleClass="field-label"/>
        <TextField fx:id="otpField" promptText="6-digit code" styleClass="input-field"/>
    </VBox>
    <Button text="Verify and continue" onAction="#handleOtpVerification" maxWidth="Infinity" styleClass="signin-button"/>
    <Button text="Back to login" onAction="#backToLogin" maxWidth="Infinity" styleClass="form-back-button"/>
    <Label fx:id="otpMessageLabel" wrapText="true" styleClass="message-label" visible="false" managed="false"/>
</VBox>
