<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" styleClass="root-canvas, auth-page"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.auth.LoginController"
           stylesheets="@../../../css/core/feedback.css, @../../../css/modules/auth/login.css">
    <GridPane>
        <columnConstraints>
            <ColumnConstraints percentWidth="40"/>
            <ColumnConstraints percentWidth="60"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="100" vgrow="ALWAYS"/>
        </rowConstraints>
        <VBox styleClass="auth-brand-panel" GridPane.columnIndex="0">
            <VBox spacing="3">
                <Label text="MotorPH" styleClass="auth-brand-name"/>
                <Label text="PAYROLL MANAGEMENT SYSTEM" styleClass="auth-brand-caption"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="7" styleClass="auth-hero-content">
                <Label text="EMPLOYEE WORKSPACE" styleClass="auth-eyebrow"/>
                <VBox spacing="3">
                    <Label text="The&#10;workforce" styleClass="auth-hero"/>
                    <Label text="payroll&#10;platform." styleClass="auth-hero, auth-hero-dark"/>
                </VBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="v1.0.2" styleClass="auth-version"/>
        </VBox>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                    styleClass="auth-scroll" GridPane.columnIndex="1">
            <StackPane styleClass="auth-form-panel">
                <StackPane maxWidth="480" maxHeight="-Infinity" alignment="CENTER">
                    <VBox fx:id="loginCard" spacing="22" styleClass="form-card">
                        <VBox spacing="12">
                            <Label text="Welcome back" styleClass="form-heading"/>
                            <Label text="Sign in to continue to your employee workspace."
                                   wrapText="true" styleClass="form-subheading"/>
                        </VBox>
                        <VBox spacing="9">
                            <Label text="Company email" styleClass="field-label"/>
                            <TextField fx:id="companyEmailField" promptText="employee@motorph.com" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="9">
                            <Label text="Password" styleClass="field-label"/>
                            <StackPane styleClass="password-input">
                                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field"/>
                                <TextField fx:id="passwordTextField" promptText="Enter your password" styleClass="input-field"
                                           visible="false" managed="false"/>
                                <Button fx:id="passwordToggleBtn" text="Show" onAction="#togglePassword"
                                        styleClass="password-toggle" StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox text="Remember me" styleClass="remember-check"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="Forgot password" onAction="#handleForgotPassword" styleClass="quiet-link"/>
                        </HBox>
                        <Button text="Sign in" onAction="#handleLogin" maxWidth="Infinity" styleClass="signin-button"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="security-badge">
                            <Label text="&#10003;" styleClass="security-icon"/>
                            <Label text="Protected by two-factor authentication" wrapText="true"
                                   styleClass="form-security-note" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label fx:id="loginMessageLabel" wrapText="true" maxWidth="Infinity" styleClass="message-label"/>
                    </VBox>
                    <fx:include fx:id="totpCard" source="totp-verify.fxml" visible="false" managed="false"/>
                    <fx:include fx:id="totpSetupCard" source="totp-setup.fxml" visible="false" managed="false"/>
                    <fx:include fx:id="forgotCard" source="forgot-password.fxml" visible="false" managed="false"/>
                    <fx:include fx:id="recoveryCard" source="totp-verify.fxml" visible="false" managed="false"/>
                    <fx:include fx:id="resetPasswordCard" source="force-change-password.fxml" visible="false" managed="false"/>
                    <fx:include fx:id="forceChangeCard" source="force-change-password.fxml" visible="false" managed="false"/>
                </StackPane>
            </StackPane>
        </ScrollPane>
    </GridPane>
</StackPane>
