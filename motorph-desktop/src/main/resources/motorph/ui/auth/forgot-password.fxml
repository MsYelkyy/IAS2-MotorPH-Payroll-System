<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.ForgotPasswordController">
    <VBox fx:id="forgotEmailCard" spacing="22" styleClass="form-card">
        <Label text="ACCOUNT RECOVERY" styleClass="form-eyebrow"/>
        <VBox spacing="12">
            <Label text="Forgot password?" styleClass="form-heading"/>
            <Label text="Enter your company email, then confirm with a code from your authenticator app."
                   wrapText="true" styleClass="form-subheading"/>
        </VBox>
        <VBox spacing="9">
            <Label text="Company email" styleClass="field-label"/>
            <TextField fx:id="resetEmailField" promptText="employee@motorph.com" styleClass="input-field"/>
        </VBox>
        <Button text="Continue" onAction="#handleSubmitRequest" maxWidth="Infinity" styleClass="signin-button"/>
        <Button text="Back to login" onAction="#backToLogin" maxWidth="Infinity" styleClass="form-back-button"/>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="security-badge">
            <Label text="?" styleClass="security-icon"/>
            <Label text="No access to your authenticator app? Contact an administrator to reset it."
                   wrapText="true" styleClass="form-security-note" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Label fx:id="forgotEmailMessageLabel" wrapText="true" styleClass="message-label" visible="false" managed="false"/>
    </VBox>
</VBox>
