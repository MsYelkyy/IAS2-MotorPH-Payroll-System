<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="verifyRoot" spacing="22" styleClass="form-card"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.TotpVerifyController">
    <Label fx:id="eyebrowLabel" text="TWO-FACTOR AUTHENTICATION" styleClass="form-eyebrow"/>
    <VBox spacing="12">
        <Label fx:id="headingLabel" text="Enter your code" minHeight="-Infinity" styleClass="form-heading"/>
        <Label fx:id="subheadingLabel" text="Enter the 6-digit code from your authenticator app."
               wrapText="true" minHeight="-Infinity" styleClass="form-subheading"/>
    </VBox>
    <VBox spacing="9">
        <Label text="Authenticator code" styleClass="field-label"/>
        <TextField fx:id="codeField" promptText="000000" styleClass="input-field, code-input"/>
        <VBox spacing="6">
            <ProgressBar fx:id="countdownBar" progress="1" maxWidth="Infinity" styleClass="countdown-bar"/>
            <Label fx:id="countdownLabel" text="Codes refresh every 30 seconds." styleClass="countdown-label"/>
        </VBox>
    </VBox>
    <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" styleClass="message-label"/>
    <Button fx:id="verifyButton" text="Verify and continue" onAction="#handleVerify" maxWidth="Infinity"
            styleClass="signin-button"/>
    <Button text="Back to login" onAction="#handleBack" maxWidth="Infinity" styleClass="form-back-button"/>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="security-badge">
        <Label text="?" styleClass="security-icon"/>
        <Label text="Lost access to your authenticator app? Ask an administrator to reset it."
               wrapText="true" styleClass="form-security-note" HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
