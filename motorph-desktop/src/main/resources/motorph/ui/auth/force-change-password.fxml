<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="22" styleClass="form-card"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.ForceChangePasswordController">
    <Label text="SECURE YOUR ACCOUNT" styleClass="form-eyebrow"/>
    <VBox spacing="12">
        <Label text="Create a new password" styleClass="form-heading"/>
        <Label text="Choose a new password before continuing to your account."
               wrapText="true" styleClass="form-subheading"/>
    </VBox>
    <VBox spacing="9">
        <Label text="New password" styleClass="field-label"/>
        <StackPane styleClass="password-input">
            <PasswordField fx:id="newPasswordField" promptText="Enter new password" styleClass="input-field"/>
            <TextField fx:id="newPasswordTextField" promptText="Enter new password" styleClass="input-field"
                       visible="false" managed="false"/>
            <Button fx:id="newPasswordToggleBtn" text="Show" onAction="#toggleNewPassword"
                    styleClass="password-toggle" StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </VBox>
    <VBox spacing="9">
        <Label text="Confirm new password" styleClass="field-label"/>
        <StackPane styleClass="password-input">
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" styleClass="input-field"/>
            <TextField fx:id="confirmPasswordTextField" promptText="Confirm new password" styleClass="input-field"
                       visible="false" managed="false"/>
            <Button fx:id="confirmPasswordToggleBtn" text="Show" onAction="#toggleConfirmPassword"
                    styleClass="password-toggle" StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>
    </VBox>
    <VBox spacing="6" styleClass="security-badge">
        <Label text="Password must contain:" styleClass="form-security-note"/>
        <Label text="At least 8 characters, one uppercase letter and one number."
               wrapText="true" styleClass="form-security-note"/>
    </VBox>
    <Button text="Update password" onAction="#handleUpdatePassword" maxWidth="Infinity" styleClass="signin-button"/>
    <Button text="Back to login" onAction="#backToLogin" maxWidth="Infinity" styleClass="form-back-button"/>
    <Label fx:id="forceChangeMessageLabel" wrapText="true" styleClass="message-label" visible="false" managed="false"/>
</VBox>
