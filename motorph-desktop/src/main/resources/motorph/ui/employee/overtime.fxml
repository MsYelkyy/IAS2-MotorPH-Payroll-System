<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="toastRoot"
           maxWidth="Infinity"
           maxHeight="Infinity"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.employee.EmployeeOvertimeController">

<VBox spacing="18"
      styleClass="leave-root"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <VBox spacing="0" maxWidth="Infinity" minHeight="-Infinity"
          styleClass="content-card, leave-card, leave-form-card">
        <Label text="New Overtime Request" styleClass="leave-card-title"/>

        <Region prefHeight="6"/>

        <Label fx:id="emptyStateLabel"
               text="No completed attendance records are available for overtime request."
               wrapText="true" visible="false" managed="false" styleClass="note-text"/>

        <Region prefHeight="16"/>

        <GridPane hgap="18" vgap="12" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Completed Attendance Day" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="attendanceErrorLabel" styleClass="field-error"/>
                </HBox>
                <ComboBox fx:id="attendanceComboBox" promptText="Select attendance day"
                          maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Overtime Type" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="overtimeTypeErrorLabel" styleClass="field-error"/>
                </HBox>
                <ComboBox fx:id="overtimeTypeComboBox" promptText="Select overtime type"
                          maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Requested Hours" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="hoursErrorLabel" styleClass="field-error"/>
                </HBox>
                <TextField fx:id="hoursField" promptText="e.g. 2"
                           maxWidth="Infinity" styleClass="input-field"/>
            </VBox>
        </GridPane>

        <Region prefHeight="12"/>

        <VBox spacing="6" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Reason" styleClass="field-label"/>
                <Label text="*" styleClass="required-asterisk"/>
                <Label fx:id="reasonErrorLabel" styleClass="field-error"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="reasonCounterLabel" text="0 / 255" styleClass="character-counter"/>
            </HBox>
            <TextArea fx:id="reasonArea" promptText="Reason for overtime"
                      wrapText="true" prefRowCount="3" maxWidth="Infinity" styleClass="input-field, leave-reason-area"/>
        </VBox>

        <Region prefHeight="18"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="submitButton" text="Submit Overtime Request" onAction="#handleSubmitOvertimeRequest"
                    styleClass="primary-button"/>
            <Button text="Clear" onAction="#handleClearOvertimeRequest"
                    styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          styleClass="content-card, leave-card, leave-history-card"
          VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="My Overtime Requests" styleClass="section-title"/>
                <Label fx:id="overtimeHistoryLabel"
                       text="View and track your overtime requests."
                       wrapText="true" styleClass="note-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="statusFilterComboBox" prefWidth="162" minWidth="162" maxWidth="162" styleClass="input-field, leave-status-filter"/>
        </HBox>

        <Region prefHeight="16"/>

        <TableView fx:id="overtimeHistoryTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                   minHeight="340"
                   styleClass="payroll-table, leave-history-table">
            <columns>
                <TableColumn fx:id="colRequestId" text="Request ID" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="colOvertimeType" text="Overtime Type" prefWidth="170" minWidth="140"/>
                <TableColumn fx:id="colHours" text="Requested Hours" prefWidth="140" minWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="colDateRequested" text="Date Requested" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120" minWidth="105"/>
            </columns>
            <placeholder>
                <Label text="No overtime requests found." styleClass="note-text"/>
            </placeholder>
        </TableView>

        <Region prefHeight="14"/>

        <StackPane>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="prevButton" text="&#8592; Previous" onAction="#handlePrevPage"
                        styleClass="secondary-button"/>
                <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="note-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="nextButton" text="Next &#8594;" onAction="#handleNextPage"
                        styleClass="secondary-button"/>
            </HBox>
            <Label fx:id="recordInfoLabel" text="0 requests" styleClass="note-text" mouseTransparent="true"/>
        </StackPane>
    </VBox>

</VBox>

</StackPane>
