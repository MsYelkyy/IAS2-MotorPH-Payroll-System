<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           styleClass="root-canvas, workspace-shell"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.employee.EmployeeMainController"
           stylesheets="@../../../css/core/base.css, @../../../css/core/shell.css, @../../../css/core/sidebar.css, @../../../css/core/cards.css, @../../../css/core/controls.css, @../../../css/core/table.css, @../../../css/core/dashboard.css, @../../../css/core/feedback.css, @../../../css/modules/shared/shared-components.css, @../../../css/modules/shared/support-ticket.css, @../../../css/modules/employee/profile.css, @../../../css/modules/employee/attendance.css, @../../../css/modules/employee/leave.css, @../../../css/core/utilities.css">

    <BorderPane styleClass="app-shell">

        <!-- LEFT: Sidebar -->
        <left>
            <VBox styleClass="sidebar">

                <VBox styleClass="sidebar-brand">
                    <Label text="MotorPH" styleClass="sidebar-brand-name"/>
                    <Label text="PAYROLL MANAGEMENT SYSTEM" styleClass="sidebar-brand-system"/>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            focusTraversable="false" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox styleClass="sidebar-nav">
                            <Label text="EMPLOYEE WORKSPACE" styleClass="sidebar-section"/>
                            <Button fx:id="dashboardNavButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button, selected-nav">
                                <graphic><fx:include source="../../../icons/navigation/grid.fxml"/></graphic>
                            </Button>
                            <Button fx:id="profileNavButton" text="Profile" onAction="#showProfile" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/user.fxml"/></graphic>
                            </Button>
                            <Button fx:id="attendanceNavButton" text="Attendance" onAction="#showAttendance" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/calendar-check.fxml"/></graphic>
                            </Button>
                            <Button fx:id="leaveNavButton" text="Leave Requests" onAction="#showLeave" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/file.fxml"/></graphic>
                            </Button>
                            <Button fx:id="overtimeNavButton" text="Overtime Requests" onAction="#showOvertime" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/clock.fxml"/></graphic>
                            </Button>
                            <Button fx:id="payslipNavButton" text="Payslip / Payroll" onAction="#showPayslip" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/card.fxml"/></graphic>
                            </Button>
                            <Label text="ACCOUNT &amp; SUPPORT" styleClass="sidebar-section"/>
                            <Button fx:id="supportTicketsNavButton" text="Support Tickets" onAction="#showSupportTickets" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/headset.fxml"/></graphic>
                            </Button>
                            <Button fx:id="settingsNavButton" text="Account Settings" onAction="#showSettings" maxWidth="Infinity" styleClass="nav-button">
                                <graphic><fx:include source="../../../icons/navigation/gear.fxml"/></graphic>
                            </Button>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox styleClass="sidebar-footer">
                    <VBox styleClass="sidebar-card">
                        <Label text="SIGNED IN AS" styleClass="sidebar-card-kicker"/>
                        <Label fx:id="dashboardEmployeeNameLabel" text="-" wrapText="true" styleClass="sidebar-card-title"/>
                        <Label fx:id="dashboardEmployeeRoleLabel" text="EMPLOYEE" styleClass="sidebar-card-copy"/>
                    </VBox>
                    <Button fx:id="switchRoleButton" text="Switch role" onAction="#handleSwitchRole"
                            visible="false" managed="false" maxWidth="Infinity" styleClass="sidebar-action"/>
                    <Button text="Log out" onAction="#handleLogout" maxWidth="Infinity" styleClass="sidebar-action, sidebar-logout"/>
                </VBox>

            </VBox>
        </left>

        <!-- CENTER: Main workspace -->
        <center>
            <VBox styleClass="app-main">

                <!-- Topbar -->
                <HBox styleClass="topbar" alignment="CENTER_LEFT">
                    <VBox styleClass="topbar-titles">
                        <Label fx:id="pageSubtitleLabel" text="EMPLOYEE WORKSPACE" styleClass="page-subtitle"/>
                        <Label fx:id="pageTitleLabel"    text="Dashboard"   styleClass="page-title"/>
                    </VBox>
                </HBox>

                <!-- Scrollable content area -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                            styleClass="workspace-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane styleClass="content-area">
                            <fx:include fx:id="dashboardView"  source="Dashboard.fxml"/>
                            <fx:include fx:id="profileView"    source="Profile.fxml"    visible="false" managed="false"/>
                            <fx:include fx:id="attendanceView" source="Attendance.fxml" visible="false" managed="false"/>
                            <fx:include fx:id="leaveView"      source="Leave.fxml"      visible="false" managed="false"/>
                            <fx:include fx:id="overtimeView"   source="Overtime.fxml"   visible="false" managed="false"/>
                            <fx:include fx:id="payslipView"
                                        source="Payslip.fxml"
                                        visible="false"
                                        managed="false"/>

                            <fx:include fx:id="supportTicketsView"
                                        source="SupportTickets.fxml"
                                        visible="false"
                                        managed="false"/>

                            <fx:include fx:id="settingsView"
                                        source="Settings.fxml"
                                        visible="false"
                                        managed="false"/>
                        </StackPane>
                    </content>
                </ScrollPane>

            </VBox>
        </center>

    </BorderPane>

</StackPane>
