<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="toastRoot"
           styleClass="support-ticket-root"
           maxWidth="Infinity"
           maxHeight="Infinity"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.employee.EmployeeSupportTicketController">

    <VBox spacing="14" maxWidth="Infinity" maxHeight="Infinity">

        <HBox styleClass="hero">
            <VBox styleClass="hero-text" HBox.hgrow="ALWAYS">
                <Label text="EMPLOYEE SUPPORT" styleClass="hero-kicker"/>
                <Label text="Need help? Send us a support request" styleClass="hero-title"/>
                <Label text="Track your requests from submission through resolution." styleClass="hero-note"/>
            </VBox>
        </HBox>

        <GridPane hgap="14" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="62" minWidth="0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="38" minWidth="0" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <VBox styleClass="panel" minWidth="0" maxWidth="Infinity" maxHeight="Infinity"
                  GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">

                <VBox styleClass="ticket-list" VBox.vgrow="ALWAYS">
                    <VBox styleClass="ticket-list-head">
                        <Label text="My tickets" styleClass="ticket-list-title"/>
                        <Label text="Requests you have submitted" styleClass="ticket-list-note"/>
                    </VBox>

                    <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS"
                               maxHeight="Infinity" minHeight="300">
                        <columns>
                            <TableColumn fx:id="colTicketId"    text="TICKET ID"     prefWidth="85"  minWidth="60"/>
                            <TableColumn fx:id="colCategory"    text="CATEGORY"      prefWidth="125" minWidth="112"/>
                            <TableColumn fx:id="colTitle"       text="TITLE"         prefWidth="170" minWidth="110"/>
                            <TableColumn fx:id="colStatus"      text="STATUS"        prefWidth="110" minWidth="100"/>
                            <TableColumn fx:id="colDateCreated" text="DATE CREATED"  prefWidth="160" minWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>

                <HBox styleClass="table-pager">
                    <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="pager-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="recordInfoLabel" text="" styleClass="pager-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="prevButton" text="Previous" onAction="#handlePrevPage" styleClass="pager-button"/>
                    <Button fx:id="nextButton" text="Next" onAction="#handleNextPage" styleClass="pager-button"/>
                </HBox>
            </VBox>

            <VBox styleClass="panel" minWidth="0" maxWidth="Infinity" maxHeight="Infinity"
                  GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">

                <VBox styleClass="ticket-form" VBox.vgrow="ALWAYS">
                    <VBox styleClass="ticket-list-head">
                        <Label text="Create new ticket" styleClass="ticket-list-title"/>
                        <Label text="Tell us what you need help with" styleClass="ticket-list-note"/>
                    </VBox>

                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="CATEGORY" styleClass="ticket-field-label"/>
                            <Label text="*" styleClass="required-asterisk"/>
                            <Label fx:id="categoryErrorLabel" styleClass="field-error"/>
                        </HBox>
                        <ComboBox fx:id="categoryComboBox" promptText="Select a category"
                                  maxWidth="Infinity" styleClass="ticket-filter-input"/>
                    </VBox>

                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="TITLE" styleClass="ticket-field-label"/>
                            <Label text="*" styleClass="required-asterisk"/>
                            <Label fx:id="titleErrorLabel" styleClass="field-error"/>
                        </HBox>
                        <TextField fx:id="titleField" maxWidth="Infinity" styleClass="ticket-filter-input"/>
                    </VBox>

                    <VBox spacing="6" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MESSAGE" styleClass="ticket-field-label"/>
                            <Label text="*" styleClass="required-asterisk"/>
                            <Label fx:id="messageErrorLabel" styleClass="field-error"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="messageCounterLabel" text="0 / 1000" styleClass="pager-text"/>
                        </HBox>
                        <TextArea fx:id="messageArea" wrapText="true" prefRowCount="5"
                                  maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Submit ticket" onAction="#handleSubmitTicket" styleClass="primary-button"/>
                        <Button text="Clear" onAction="#handleClearForm" styleClass="secondary-button"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="formMessageLabel" wrapText="true" styleClass="message-label" maxWidth="200"/>
                    </HBox>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>
</StackPane>
