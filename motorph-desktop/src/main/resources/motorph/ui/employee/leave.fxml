<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="toastRoot"
           maxWidth="Infinity"
           maxHeight="Infinity"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.employee.EmployeeLeaveController">

<VBox spacing="18"
      styleClass="leave-root"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <VBox spacing="0" maxWidth="Infinity" styleClass="content-card, leave-card, leave-credits-card">
        <Label text="Available Credits" styleClass="leave-card-title"/>
        <Region prefHeight="16"/>
        <HBox fx:id="leaveCreditsBox" alignment="CENTER" spacing="0" maxWidth="Infinity" styleClass="leave-credits-row"/>
    </VBox>

    <VBox spacing="0" maxWidth="Infinity" styleClass="content-card, leave-card, leave-form-card">
        <Label text="New Leave Request" styleClass="leave-card-title"/>

        <Region prefHeight="22"/>

        <GridPane hgap="18" vgap="12" maxWidth="Infinity" styleClass="leave-form-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Leave Type" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="leaveTypeErrorLabel" styleClass="field-error"/>
                </HBox>
                <ComboBox fx:id="leaveTypeComboBox" promptText="Select leave type"
                          maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="From Date" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="fromDateErrorLabel" styleClass="field-error"/>
                </HBox>
                <DatePicker fx:id="leaveStartDatePicker" promptText="Select from date"
                            maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="To Date" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="toDateErrorLabel" styleClass="field-error"/>
                </HBox>
                <DatePicker fx:id="leaveEndDatePicker" promptText="Select to date"
                            maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Total Hours" styleClass="field-label"/>
                    <Label fx:id="leaveHoursErrorLabel" styleClass="field-error"/>
                </HBox>
                <TextField fx:id="leaveHoursField" promptText="Auto-computed"
                           editable="false" maxWidth="Infinity" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Reason" styleClass="field-label"/>
                    <Label text="*" styleClass="required-asterisk"/>
                    <Label fx:id="reasonErrorLabel" styleClass="field-error"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="reasonCounterLabel" text="0 / 255" styleClass="character-counter"/>
                </HBox>
                <TextArea fx:id="leaveReasonArea" promptText="Reason for leave"
                          wrapText="true" prefRowCount="3" maxWidth="Infinity" styleClass="input-field, leave-reason-area"/>
            </VBox>
        </GridPane>

        <Region prefHeight="16"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Submit Leave Request" onAction="#handleSubmitLeaveRequest"
                    styleClass="primary-button"/>
            <Button text="Clear" onAction="#handleClearLeaveRequest"
                    styleClass="secondary-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="leaveMessageLabel" wrapText="true" styleClass="message-label"/>
        </HBox>
    </VBox>

    <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          styleClass="content-card, leave-card, leave-history-card"
          VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Leave Request History" styleClass="section-title"/>
                <Label fx:id="leaveHistoryLabel"
                       text="View and track your leave requests."
                       wrapText="true" styleClass="note-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="statusFilterComboBox" prefWidth="162" minWidth="162" maxWidth="162" styleClass="input-field, leave-status-filter"/>
        </HBox>

        <Region prefHeight="16"/>

        <TableView fx:id="leaveHistoryTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                   minHeight="340"
                   styleClass="payroll-table, leave-history-table">
            <columns>
                <TableColumn fx:id="colRequestId" text="Request ID" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="colLeaveType" text="Leave Type" prefWidth="170" minWidth="140"/>
                <TableColumn fx:id="colFromDate" text="From" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colToDate" text="To" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colTotalHours" text="Total Hours" prefWidth="120" minWidth="105"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="130" minWidth="110"/>
                <TableColumn fx:id="colDateRequested" text="Date Requested" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120" minWidth="105"/>
            </columns>
            <placeholder>
                <Label text="No leave requests found." styleClass="note-text"/>
            </placeholder>
        </TableView>

        <Region prefHeight="14"/>

        <StackPane>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="leavePrevButton" text="&#8592; Previous" onAction="#handleLeavePrevPage"
                        styleClass="secondary-button"/>
                <Label fx:id="leavePageLabel" text="Page 1 of 1" styleClass="note-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="leaveNextButton" text="Next &#8594;" onAction="#handleLeaveNextPage"
                        styleClass="secondary-button"/>
            </HBox>
            <Label fx:id="leaveRecordInfoLabel" text="0 requests" styleClass="note-text" mouseTransparent="true"/>
        </StackPane>
    </VBox>

</VBox>

</StackPane>
