<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.hr.HrAttendanceController"
      VBox.vgrow="ALWAYS" spacing="6" styleClass="payroll-module, attendance-module">

    <StackPane fx:id="toastRoot" VBox.vgrow="ALWAYS">

        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="payroll-tab-pane" VBox.vgrow="ALWAYS">
            <tabs>

                <!-- ░░░ ATTENDANCE LOGS ░░░ -->
                <Tab text="Attendance Logs">
                    <content>
                        <VBox spacing="14">

                            <!-- Search + department filter row -->
                            <HBox styleClass="attendance-filter-row" spacing="12" alignment="CENTER_LEFT">
                                <TextField fx:id="searchField" promptText="Search employee"
                                           HBox.hgrow="ALWAYS" styleClass="input-field"/>
                                <ComboBox fx:id="departmentFilterCombo" promptText="All Departments"
                                          prefWidth="240" styleClass="input-field"/>
                            </HBox>

                            <VBox styleClass="content-card, payroll-tab-card, table-card" spacing="16"
                                  VBox.vgrow="ALWAYS">

                                <VBox spacing="2">
                                    <Label text="Attendance Logs" styleClass="section-title"/>
                                                                    </VBox>

                                <HBox spacing="12">
                                    <VBox styleClass="metric-card, payroll-summary-card" spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="PRESENT TODAY" styleClass="metric-label"/>
                                        <Label fx:id="presentTodayCard" text="0" styleClass="metric-value"/>
                                    </VBox>
                                    <VBox styleClass="metric-card, payroll-summary-card" spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="LATE TODAY" styleClass="metric-label"/>
                                        <Label fx:id="lateTodayCard" text="0" styleClass="metric-value"/>
                                    </VBox>
                                    <VBox styleClass="metric-card, payroll-summary-card" spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="ON LEAVE TODAY" styleClass="metric-label"/>
                                        <Label fx:id="onLeaveTodayCard" text="0" styleClass="metric-value"/>
                                    </VBox>
                                </HBox>

                                <TableView fx:id="logTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" prefHeight="430">
                                    <columns>
                                        <TableColumn fx:id="logWorkDateColumn" text="WORK DATE" prefWidth="140" minWidth="120"/>
                                        <TableColumn fx:id="logEmployeeColumn" text="EMPLOYEE" prefWidth="210" minWidth="160"/>
                                        <TableColumn fx:id="logDepartmentColumn" text="DEPARTMENT" prefWidth="150" minWidth="110"/>
                                        <TableColumn fx:id="logTimeInColumn" text="TIME IN" prefWidth="110" minWidth="90"/>
                                        <TableColumn fx:id="logTimeOutColumn" text="TIME OUT" prefWidth="110" minWidth="90"/>
                                        <TableColumn fx:id="logHoursColumn" text="HOURS" prefWidth="100" minWidth="80"/>
                                        <TableColumn fx:id="logStatusColumn" text="STATUS" prefWidth="120" minWidth="100"/>
                                    </columns>
                                    <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No attendance logs match the current filters" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
                                </TableView>
                                <HBox styleClass="table-pager">
                                    <VBox.margin><Insets left="-19" right="-19"/></VBox.margin>
                                    <Label fx:id="logPageLabel" text="Page 1 of 1" styleClass="pager-text"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="logRecordInfoLabel" text="" styleClass="pager-text"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="logPrevButton" text="Previous" styleClass="pager-button"/>
                                    <Button fx:id="logNextButton" text="Next" styleClass="pager-button"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- ░░░ ALL RECORDS ░░░ -->
                <Tab text="All Records">
                    <content>
                        <VBox spacing="14">

                            <!-- Search + department filter row -->
                            <HBox styleClass="attendance-filter-row" spacing="12" alignment="CENTER_LEFT">
                                <TextField fx:id="allRecordsSearchField" promptText="Search employee"
                                           HBox.hgrow="ALWAYS" styleClass="input-field"/>
                                <ComboBox fx:id="allRecordsDepartmentCombo" promptText="All Departments"
                                          prefWidth="240" styleClass="input-field"/>
                            </HBox>

                            <VBox styleClass="content-card, payroll-tab-card, table-card" spacing="16"
                                  VBox.vgrow="ALWAYS">

                                <VBox spacing="2">
                                    <Label text="All Records" styleClass="section-title"/>
                                                                    </VBox>

                                <TableView fx:id="allRecordsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity" prefHeight="520">
                                    <columns>
                                        <TableColumn fx:id="allWorkDateColumn" text="WORK DATE" prefWidth="140" minWidth="120"/>
                                        <TableColumn fx:id="allEmployeeColumn" text="EMPLOYEE" prefWidth="210" minWidth="160"/>
                                        <TableColumn fx:id="allDepartmentColumn" text="DEPARTMENT" prefWidth="150" minWidth="110"/>
                                        <TableColumn fx:id="allTimeInColumn" text="TIME IN" prefWidth="110" minWidth="90"/>
                                        <TableColumn fx:id="allTimeOutColumn" text="TIME OUT" prefWidth="110" minWidth="90"/>
                                        <TableColumn fx:id="allHoursColumn" text="HOURS" prefWidth="100" minWidth="80"/>
                                        <TableColumn fx:id="allStatusColumn" text="STATUS" prefWidth="120" minWidth="100"/>
                                    </columns>
                                    <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No attendance records match the current filters" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
                                </TableView>
                                <HBox styleClass="table-pager">
                                    <VBox.margin><Insets left="-19" right="-19"/></VBox.margin>
                                    <Label fx:id="allPageLabel" text="Page 1 of 1" styleClass="pager-text"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="allRecordInfoLabel" text="" styleClass="pager-text"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="allPrevButton" text="Previous" styleClass="pager-button"/>
                                    <Button fx:id="allNextButton" text="Next" styleClass="pager-button"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

    </StackPane>

</VBox>
