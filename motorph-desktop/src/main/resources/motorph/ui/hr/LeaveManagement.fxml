<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.hr.HrLeaveController"
      styleClass="payroll-module"
      VBox.vgrow="ALWAYS">

    <HBox styleClass="module-toolbar" spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="backButton" text="Back" onAction="#handleBack"
                visible="false" managed="false" styleClass="secondary-button"/>
        <TextField fx:id="employeeSearchField" prefWidth="260"
                   promptText="Search employee by name or ID" styleClass="input-field"/>
        <ComboBox fx:id="statusFilterCombo" promptText="Status"
                  prefWidth="150" styleClass="input-field"/>
        <ComboBox fx:id="leaveTypeFilterCombo" promptText="Leave Type"
                  prefWidth="180" styleClass="input-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text"/>
    </HBox>

    <TabPane fx:id="segmentTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="payroll-tab-pane">
        <tabs>
            <Tab fx:id="leaveTab" text="Leave Requests"/>
            <Tab fx:id="overtimeTab" text="Overtime Requests"/>
        </tabs>
    </TabPane>

    <StackPane fx:id="toastRoot" VBox.vgrow="ALWAYS">

        <VBox fx:id="listPanel" styleClass="content-card" spacing="12">
            <TableView fx:id="leaveTable" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="leaveIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                    <TableColumn fx:id="leaveEmployeeColumn" text="EMPLOYEE" prefWidth="220" minWidth="170"/>
                    <TableColumn fx:id="leaveTypeColumn" text="LEAVE TYPE" prefWidth="170" minWidth="130"/>
                    <TableColumn fx:id="leavePeriodColumn" text="PERIOD" prefWidth="220" minWidth="170"/>
                    <TableColumn fx:id="leaveHoursColumn" text="HRS" prefWidth="80" minWidth="70"/>
                    <TableColumn fx:id="leaveStatusColumn" text="STATUS" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="leaveSubmittedColumn" text="SUBMITTED" prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="leaveActionColumn" text="ACTIONS" prefWidth="120" minWidth="100"/>
                </columns>
                <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No leave requests match the current filters" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="detailPanel" visible="false" managed="false"
              styleClass="content-card" spacing="16">

            <HBox spacing="0">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="EMPLOYEE" styleClass="field-label"/>
                    <Label fx:id="detailEmployeeLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="LEAVE TYPE" styleClass="field-label"/>
                    <Label fx:id="detailLeaveTypeLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="STATUS" styleClass="field-label"/>
                    <Label fx:id="detailStatusLabel" styleClass="section-title"/>
                </VBox>
            </HBox>

            <Separator/>

            <HBox spacing="32">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox><Label text="Request ID" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailIdLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Period" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailPeriodLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Leave Hours" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailHoursLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reason" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailReasonLabel" styleClass="data-line" HBox.hgrow="ALWAYS" wrapText="true"/></HBox>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox><Label text="Date Submitted" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailSubmittedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reviewed By" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailApproverLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reviewed On" prefWidth="130" styleClass="muted-text"/><Label fx:id="detailReviewedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                </VBox>
            </HBox>

            <Separator/>

            <Label fx:id="detailSelfNoteLabel"
                   text="You cannot action your own leave request."
                   styleClass="muted-text"
                   visible="false" managed="false"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="approveButton" text="Approve Leave" onAction="#handleApprove"
                        styleClass="primary-button"/>
                <Button fx:id="rejectButton" text="Reject Leave" onAction="#handleReject"
                        styleClass="danger-outline-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="viewCreditsButton" text="View Credits"
                        onAction="#handleViewCredits" styleClass="secondary-button"/>
            </HBox>

        </VBox>

        <VBox fx:id="creditsPanel" visible="false" managed="false"
              styleClass="content-card" spacing="12">
            <Label fx:id="creditsHeaderLabel" styleClass="section-title"/>

            <TableView fx:id="creditTable" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="creditTypeColumn" text="LEAVE TYPE" prefWidth="220" minWidth="170"/>
                    <TableColumn fx:id="creditTotalColumn" text="TOTAL" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="creditUsedColumn" text="USED" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="creditRemainingColumn" text="REMAINING" prefWidth="160" minWidth="120"/>
                </columns>
                <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No leave credit records found for this employee" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="overtimeListPanel" visible="false" managed="false"
              styleClass="content-card" spacing="12">
            <TableView fx:id="overtimeTable" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="otIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                    <TableColumn fx:id="otEmployeeColumn" text="EMPLOYEE" prefWidth="200" minWidth="150"/>
                    <TableColumn fx:id="otDepartmentColumn" text="DEPARTMENT" prefWidth="160" minWidth="120"/>
                    <TableColumn fx:id="otDateColumn" text="DATE" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="otTypeColumn" text="OVERTIME TYPE" prefWidth="160" minWidth="120"/>
                    <TableColumn fx:id="otHoursColumn" text="HRS" prefWidth="80" minWidth="70"/>
                    <TableColumn fx:id="otStatusColumn" text="STATUS" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="otActionColumn" text="ACTIONS" prefWidth="120" minWidth="100"/>
                </columns>
                <placeholder>
                    <VBox styleClass="table-empty">
                        <Label text="No overtime requests match the current filters" styleClass="table-empty-title"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="overtimeDetailPanel" visible="false" managed="false"
              styleClass="content-card" spacing="16">

            <HBox spacing="0">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="EMPLOYEE" styleClass="field-label"/>
                    <Label fx:id="otDetailEmployeeLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="OVERTIME TYPE" styleClass="field-label"/>
                    <Label fx:id="otDetailTypeLabel" styleClass="section-title"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="STATUS" styleClass="field-label"/>
                    <Label fx:id="otDetailStatusLabel" styleClass="section-title"/>
                </VBox>
            </HBox>

            <Separator/>

            <HBox spacing="32">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox><Label text="Request ID" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailIdLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Department" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailDepartmentLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Date" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailDateLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Requested Hours" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailHoursLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reason" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailReasonLabel" styleClass="data-line" HBox.hgrow="ALWAYS" wrapText="true"/></HBox>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox><Label text="Date Submitted" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailSubmittedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reviewed By" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailApproverLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Reviewed On" prefWidth="130" styleClass="muted-text"/><Label fx:id="otDetailReviewedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                </VBox>
            </HBox>

            <Separator/>

            <Label fx:id="otDetailSelfNoteLabel"
                   text="You cannot action your own overtime request."
                   styleClass="muted-text"
                   visible="false" managed="false"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="otApproveButton" text="Approve Overtime" onAction="#handleApproveOvertime"
                        styleClass="primary-button"/>
                <Button fx:id="otRejectButton" text="Reject Overtime" onAction="#handleRejectOvertime"
                        styleClass="danger-outline-button"/>
            </HBox>

        </VBox>

    </StackPane>

</VBox>
