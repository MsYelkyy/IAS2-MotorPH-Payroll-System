<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Shared Reports module, consumed by the Admin, HR, Finance and IT shells.
  Filters live in fixed grid slots: switching report type only enables or disables them,
  so controls never move between report types.
-->
<VBox spacing="14"
      minWidth="0"
      maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.reports.ReportsController"
      VBox.vgrow="ALWAYS">

    <HBox styleClass="hero">
        <VBox styleClass="hero-text" HBox.hgrow="ALWAYS">
            <Label text="ORGANIZATION REPORTING" styleClass="hero-kicker"/>
            <Label text="Generate and export organization reports" styleClass="hero-title"/>
            <Label text="Choose a report, define its scope, then preview before export." styleClass="hero-note"/>
        </VBox>
        <Label text="PDF EXPORT" styleClass="hero-tag"/>
    </HBox>

    <GridPane hgap="15" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints minWidth="0" hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="343" prefWidth="343" maxWidth="343"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints valignment="TOP" vgrow="NEVER"/>
        </rowConstraints>

        <VBox styleClass="panel" minWidth="0" maxWidth="Infinity"
              GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.fillHeight="false">

            <HBox styleClass="report-head">
                <VBox styleClass="report-head-text" HBox.hgrow="ALWAYS">
                    <Label text="REPORT CONFIGURATION" styleClass="report-kicker"/>
                    <Label text="Generate report" styleClass="report-title"/>
                </VBox>
                <Label fx:id="reportStatusLabel" text="Required fields are ready" styleClass="report-status-text"/>
            </HBox>

            <VBox styleClass="report-step">
                <HBox styleClass="report-step-head">
                    <Label text="1" styleClass="report-step-badge"/>
                    <Label text="Report scope" styleClass="report-step-title"/>
                </HBox>
                <GridPane hgap="14" vgap="14" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox styleClass="report-field" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0">
                        <Label text="Report Type" styleClass="report-field-label"/>
                        <ComboBox fx:id="reportTypeCombo" promptText="Select report type"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="departmentRow" styleClass="report-field" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1">
                        <Label text="Department" styleClass="report-field-label"/>
                        <ComboBox fx:id="departmentCombo" promptText="All Departments"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="employeeRow" styleClass="report-field" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2">
                        <Label text="Employee" styleClass="report-field-label"/>
                        <ComboBox fx:id="employeeCombo" promptText="Select Employee"
                                  styleClass="report-input" minWidth="0" prefWidth="10" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox styleClass="report-step">
                <HBox styleClass="report-step-head">
                    <Label text="2" styleClass="report-step-badge"/>
                    <Label text="Report period" styleClass="report-step-title"/>
                </HBox>
                <GridPane hgap="14" vgap="14" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox fx:id="dateRangeSection" styleClass="report-field" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="0">
                        <Label text="Date Range" styleClass="report-field-label"/>
                        <ComboBox fx:id="dateRangeCombo" promptText="Select date range"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>

                    <HBox fx:id="datePickerRow" spacing="14" minWidth="0" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.columnSpan="2">
                        <VBox styleClass="report-field" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                            <Label text="From" styleClass="report-field-label"/>
                            <DatePicker fx:id="dateFromPicker" promptText="Use Custom date range"
                                        styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="report-field" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                            <Label text="To" styleClass="report-field-label"/>
                            <DatePicker fx:id="dateToPicker" promptText="Use Custom date range"
                                        styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </GridPane>
            </VBox>

            <VBox styleClass="report-step">
                <HBox styleClass="report-step-head">
                    <Label text="3" styleClass="report-step-badge"/>
                    <Label text="Report filters" styleClass="report-step-title"/>
                </HBox>
                <GridPane hgap="14" vgap="14" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <StackPane minWidth="0" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <VBox fx:id="statusRow" styleClass="report-field" minWidth="0" maxWidth="Infinity">
                            <Label text="Attendance Status" styleClass="report-field-label"/>
                            <ComboBox fx:id="statusCombo" promptText="All Statuses"
                                      styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                        </VBox>
                        <VBox fx:id="actionRow" styleClass="report-field" minWidth="0" maxWidth="Infinity">
                            <Label text="Action" styleClass="report-field-label"/>
                            <ComboBox fx:id="actionCombo" promptText="All Actions"
                                      styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                        </VBox>
                    </StackPane>

                    <VBox fx:id="payrunRow" styleClass="report-field" minWidth="0" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Payroll" styleClass="report-field-label"/>
                        <ComboBox fx:id="payrunCombo" promptText="Any Payrun"
                                  styleClass="report-input" minWidth="0" prefWidth="10" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="categoryRow" styleClass="report-field" minWidth="0" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="2">
                        <Label text="Category" styleClass="report-field-label"/>
                        <ComboBox fx:id="categoryCombo" promptText="All Categories"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="routingTeamRow" styleClass="report-field" minWidth="0" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="Routing Team" styleClass="report-field-label"/>
                        <ComboBox fx:id="routingTeamCombo" promptText="All Teams"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="ticketStatusRow" styleClass="report-field" minWidth="0" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Label text="Ticket Status" styleClass="report-field-label"/>
                        <ComboBox fx:id="ticketStatusCombo" promptText="All Statuses"
                                  styleClass="report-input" minWidth="0" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>
            </VBox>
        </VBox>

        <VBox styleClass="panel" minWidth="343" prefWidth="343" maxWidth="343"
              GridPane.columnIndex="1" GridPane.fillHeight="false">

            <VBox styleClass="report-summary-head">
                <Label text="REPORT SUMMARY" styleClass="report-kicker"/>
                <Label fx:id="summaryTitleLabel" text="Attendance Report" styleClass="report-title"/>
                <Label text="Review the selected scope before generating your file." wrapText="true" styleClass="report-note"/>
            </VBox>

            <VBox styleClass="report-summary-rows">
                <HBox styleClass="report-summary-row">
                    <Label text="Department" styleClass="report-summary-key"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="summaryDepartmentLabel" text="All Departments" styleClass="report-summary-value"/>
                </HBox>
                <HBox styleClass="report-summary-row">
                    <Label text="Employee" styleClass="report-summary-key"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="summaryEmployeeLabel" text="All employees" styleClass="report-summary-value"/>
                </HBox>
                <HBox styleClass="report-summary-row">
                    <Label text="Date range" styleClass="report-summary-key"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="summaryDateRangeLabel" text="This Month" styleClass="report-summary-value"/>
                </HBox>
                <HBox styleClass="report-summary-row">
                    <Label text="Output" styleClass="report-summary-key"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="PDF document" styleClass="report-summary-value"/>
                </HBox>
            </VBox>

            <VBox styleClass="report-summary-foot">
                <VBox fx:id="summaryStatusBox" styleClass="report-status, report-status-ready">
                    <Label fx:id="summaryStatusTitleLabel" text="Preview ready" styleClass="report-status-title"/>
                    <Label fx:id="summaryStatusNoteLabel" text="Your report configuration is valid and ready to export."
                           wrapText="true" styleClass="report-status-note"/>
                </VBox>
                <VBox spacing="8">
                    <Button fx:id="previewButton" text="Preview Report" onAction="#handlePreview"
                            styleClass="primary-button, report-action" maxWidth="Infinity"/>
                    <Button fx:id="exportButton" text="Export PDF" onAction="#handleExport"
                            styleClass="outline-button, report-action" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </VBox>
    </GridPane>

    <!-- toast anchor; messages appear as toasts, never in the layout -->
    <Label fx:id="moduleMessageLabel" visible="false" managed="false"/>

</VBox>
