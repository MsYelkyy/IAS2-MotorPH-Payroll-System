<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="toastRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.finance.FinanceViewPayslipController">

    <VBox spacing="18">

        <!-- ── Payslip Search ───────────────────────────────────── -->
        <VBox spacing="14" styleClass="content-card">
            <Label text="Payslip Search" styleClass="section-title"/>

            <HBox spacing="14" alignment="BOTTOM_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Employee" styleClass="metric-label"/>
                    <ComboBox fx:id="employeeCombo" promptText="Select Employee"
                              maxWidth="Infinity" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Payrun" styleClass="metric-label"/>
                    <ComboBox fx:id="payrunCombo" promptText="Select Payrun"
                              maxWidth="Infinity" styleClass="input-field"/>
                </VBox>

                <Button fx:id="searchButton" text="Search" onAction="#handleSearch"
                        minWidth="150" prefHeight="42" styleClass="primary-button"/>
            </HBox>
        </VBox>

        <!-- ── Results: Employee Details + Payslip Preview ──────── -->
        <HBox spacing="18" VBox.vgrow="ALWAYS">

            <!-- Employee Details -->
            <VBox spacing="14" styleClass="content-card" minWidth="360" prefWidth="360">
                <Label text="Employee Details" styleClass="section-title"/>

                <GridPane hgap="14" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110" prefWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints/><RowConstraints/><RowConstraints/><RowConstraints/>
                        <RowConstraints/><RowConstraints/><RowConstraints/><RowConstraints/>
                    </rowConstraints>

                    <Label text="Name"       styleClass="finance-detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="detailNameLabel" text="—" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Employee ID" styleClass="finance-detail-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="detailEmployeeIdLabel" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Department" styleClass="finance-detail-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="detailDepartmentLabel" text="—" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Position"   styleClass="finance-detail-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="detailPositionLabel" text="—" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Period"     styleClass="finance-detail-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="detailPeriodLabel" text="—" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Gross"      styleClass="finance-detail-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="detailGrossLabel" text="—" styleClass="payslip-amount" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Deductions" styleClass="finance-detail-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="detailDeductionsLabel" text="—" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Net Pay"    styleClass="finance-detail-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <Label fx:id="detailNetPayLabel" text="—" styleClass="payslip-amount" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>

                <Region prefHeight="6"/>

                <Button fx:id="previewButton" text="Preview" onAction="#handlePreview"
                        maxWidth="Infinity" prefHeight="42" styleClass="primary-button"/>
                <Button fx:id="exportButton" text="Export PDF" onAction="#handleExportPdf"
                        maxWidth="Infinity" prefHeight="42" styleClass="secondary-button"/>
                <Button fx:id="printButton" text="Print" onAction="#handlePrint"
                        maxWidth="Infinity" prefHeight="42" styleClass="secondary-button"/>
            </VBox>

            <!-- Payslip Preview -->
            <VBox spacing="14" styleClass="content-card" HBox.hgrow="ALWAYS">
                <Label text="Payslip Preview" styleClass="section-title"/>
                <TextArea fx:id="previewArea" editable="false" wrapText="true"
                          VBox.vgrow="ALWAYS" styleClass="payslip-preview-area"/>
            </VBox>

        </HBox>

    </VBox>

</StackPane>
