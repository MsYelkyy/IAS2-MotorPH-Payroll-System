                                    <PasswordField fx:id="settingsOldPasswordField"     promptText="Current password"      styleClass="input-field"/>
                                    <PasswordField fx:id="settingsNewPasswordField"     promptText="New password"          styleClass="input-field"/>
                                    <PasswordField fx:id="settingsConfirmPasswordField" promptText="Confirm new password"  styleClass="input-field"/>
                                    <Button text="Change Password" onAction="#handleChangePassword" styleClass="success-button"/>
                                </VBox>
                            </VBox>

                        </StackPane>
                    </content>
                </ScrollPane>

                <!-- Footer bar — message left, toggles right -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="footerbar">
                    <Label fx:id="appMessageLabel" text="Welcome to your employee workspace." styleClass="success-message"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>
        </center>
    </BorderPane>

    <!-- Sliding side panel -->
    <VBox fx:id="sidePanel" visible="false" managed="false" styleClass="side-panel" StackPane.alignment="TOP_RIGHT">
        <VBox styleClass="side-panel-content">
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label text="Options" styleClass="side-panel-title"/>
                <Button text="✕" onAction="#toggleSidePanel" styleClass="side-panel-close"/>
            </HBox>
            <Separator/>
            <Button text="Profile"          onAction="#showProfile"   styleClass="side-panel-item"/>
            <Button text="Notifications"    onAction="#showDashboard" styleClass="side-panel-item"/>
            <Button text="Help"             onAction="#showDashboard" styleClass="side-panel-item"/>
            <Separator/>
            <Button text="Account Settings" onAction="#showSettings"  styleClass="side-panel-item"/>
        </VBox>
    </VBox>

</StackPane>
