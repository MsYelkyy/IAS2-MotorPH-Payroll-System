<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="motorph.ui.LoginController"
            prefWidth="1000"
            prefHeight="650"
            style="-fx-background-color: #F5F7FA;">

    <left>
        <StackPane prefWidth="450"
                   style="-fx-background-color: linear-gradient(to bottom right, #003B5C, #005C8A);">

            <VBox alignment="CENTER" spacing="15">

                <Label text="MotorPH"
                       style="-fx-text-fill: white;">
                    <font>
                        <Font size="40"/>
                    </font>
                </Label>

                <Label text="Payroll Management System"
                       style="-fx-text-fill: #D6E4F0;">
                    <font>
                        <Font size="16"/>
                    </font>
                </Label>

            </VBox>

        </StackPane>
    </left>

    <center>
        <StackPane>

            <VBox spacing="15"
                  alignment="CENTER"
                  maxWidth="380">

                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="LOGIN"
                       style="-fx-text-fill: #003B5C; -fx-font-weight: bold;">
                    <font>
                        <Font size="32"/>
                    </font>
                </Label>

                <VBox spacing="5">
                    <Label text="Company Email"/>

                    <TextField fx:id="usernameField"
                               promptText="Enter company email"
                               prefHeight="40"/>
                </VBox>

                <Label fx:id="usernameErrorLabel"
                       textFill="red"/>

                <VBox spacing="5">
                    <Label text="Password"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Enter password"
                                   prefHeight="40"/>
                </VBox>

                <Label fx:id="passwordErrorLabel"
                       textFill="red"/>

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink text="Forgot Password?"
                               onAction="#handleForgotPassword"/>
                </HBox>

                <Button text="Login"
                        fx:id="loginButton"
                        onAction="#handleLogin"
                        prefWidth="380"
                        prefHeight="45"
                        style="
                            -fx-background-color: #003B5C;
                            -fx-text-fill: white;
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-background-radius: 8;
                        "/>

                <Label fx:id="messageLabel"
                       textFill="#003B5C"/>

            </VBox>

        </StackPane>
    </center>

</BorderPane>