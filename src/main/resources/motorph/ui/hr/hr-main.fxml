<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.hr.HrMainController"
           stylesheets="@../../../css/core/base.css, @../../../css/core/tokens.css, @../../../css/themes/dark.css, @../../../css/themes/light.css, @../../../css/core/feedback.css, @../../../css/core/typography.css, @../../../css/modules/shared/shared-components.css, @../../../css/modules/hr/dashboard.css, @../../../css/core/utilities.css">

    <BorderPane styleClass="app-shell">

        <!-- LEFT: Sidebar -->
        <left>
            <VBox spacing="10" styleClass="sidebar">

                <!-- Brand mark -->
                <VBox spacing="2" styleClass="sidebar-brand">
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="Motor" styleClass="sidebar-brand-motor"/>
                        <Label text="PH"    styleClass="sidebar-brand-ph"/>
                    </HBox>
                    <Label text="HR MANAGEMENT SYSTEM" styleClass="sidebar-brand-system"/>
                </VBox>

                <Separator/>

                <!-- Navigation -->
                <Button fx:id="dashboardNavButton" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button, selected-nav"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Employee identity card -->
                <VBox spacing="6" styleClass="sidebar-card">
                    <Label text="LOGGED IN AS" styleClass="sidebar-card-kicker"/>
                    <Label fx:id="employeeNameLabel" text="-"  wrapText="true" styleClass="sidebar-card-title"/>
                    <Label fx:id="employeeRoleLabel" text="HR"                 styleClass="sidebar-card-copy"/>
                </VBox>

                <Button fx:id="switchRoleButton" text="Switch Role" onAction="#handleSwitchRole"
                        visible="false" managed="false" maxWidth="Infinity" styleClass="secondary-button"/>
                <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="danger-outline-button"/>

            </VBox>
        </left>

        <!-- CENTER: Main workspace -->
        <center>
            <VBox styleClass="app-main">

                <!-- Topbar -->
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
                    <VBox spacing="2">
                        <Label fx:id="pageTitleLabel"    text="Dashboard"           styleClass="page-title"/>
                        <Label fx:id="pageSubtitleLabel" text="HR MANAGEMENT SYSTEM" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Active Session" styleClass="status-pill success-pill"/>
                    <HBox fx:id="globalControlsHost" alignment="CENTER_RIGHT" spacing="6" HBox.hgrow="NEVER"/>
                </HBox>

                <!-- Scrollable content -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="workspace-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane styleClass="content-area">
                            <fx:include fx:id="dashboardView" source="Dashboard.fxml"/>
                        </StackPane>
                    </content>
                </ScrollPane>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="footerbar">
                    <Label fx:id="appMessageLabel" text="HR Management System" styleClass="success-message"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>
        </center>

    </BorderPane>

</StackPane>
