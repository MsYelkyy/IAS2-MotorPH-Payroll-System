<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14"
      fillWidth="true"
      maxWidth="Infinity"
      minWidth="0"
      styleClass="hr-dashboard"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.hr.HrDashboardController">

    <HBox spacing="18" maxWidth="Infinity" minWidth="0">

        <!-- Metric column -->
        <VBox spacing="14" prefWidth="210" minWidth="180" maxWidth="250" HBox.hgrow="NEVER">
            <VBox spacing="6" styleClass="metric-card">
                <Label text="TOTAL EMPLOYEES" styleClass="metric-label"/>
                <Label fx:id="totalEmployeesLabel" text="—" styleClass="metric-value"/>
                <Label text="All employee records" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card">
                <Label text="ACTIVE EMPLOYEES" styleClass="metric-label"/>
                <Label fx:id="activeEmployeesLabel" text="—" styleClass="metric-value, attendance-value"/>
                <Label text="Currently employed" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card">
                <Label text="PRESENT TODAY" styleClass="metric-label"/>
                <Label fx:id="presentTodayLabel" text="—" styleClass="metric-value, attendance-value"/>
                <Label text="Present or late today" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card">
                <Label text="ON LEAVE TODAY" styleClass="metric-label"/>
                <Label fx:id="onLeaveTodayLabel" text="—" styleClass="metric-value"/>
                <Label text="Approved leave today" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="6" styleClass="metric-card">
                <Label text="PENDING REQUESTS" styleClass="metric-label"/>
                <Label fx:id="pendingLeaveLabel" text="—" styleClass="metric-value"/>
                <Label text="Leave" styleClass="muted-text"/>
            </VBox>
        </VBox>

        <!-- Chart / data column -->
        <VBox spacing="14" minWidth="680" maxWidth="Infinity" HBox.hgrow="ALWAYS">

            <GridPane hgap="14" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" minWidth="320" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" minWidth="320" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="10" minWidth="320" maxWidth="Infinity"
                      styleClass="chart-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                    <Label text="ATTENDANCE TREND" styleClass="section-title"/>
                    <LineChart fx:id="attendanceTrendChart" animated="false" legendVisible="false"
                               createSymbols="true" minWidth="0" maxWidth="Infinity"
                               styleClass="portal-chart" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis tickLabelFill="#A5A8B0"/></xAxis>
                        <yAxis><NumberAxis   tickLabelFill="#A5A8B0"/></yAxis>
                    </LineChart>
                </VBox>
                <VBox spacing="10" minWidth="320" maxWidth="Infinity"
                      styleClass="chart-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <Label text="DEPARTMENT DISTRIBUTION" styleClass="section-title"/>
                    <BarChart fx:id="departmentDistributionChart" animated="false" legendVisible="false"
                              minWidth="0" maxWidth="Infinity"
                              styleClass="portal-chart" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis tickLabelFill="#A5A8B0"/></xAxis>
                        <yAxis><NumberAxis   tickLabelFill="#A5A8B0"/></yAxis>
                    </BarChart>
                </VBox>
            </GridPane>

            <GridPane hgap="14" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="62" minWidth="420" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="38" minWidth="300" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="10" minWidth="420" maxWidth="Infinity"
                      styleClass="chart-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                    <Label text="ATTENDANCE SUMMARY" styleClass="section-title"/>
                    <BarChart fx:id="attendanceSummaryChart" animated="false" legendVisible="true"
                              minWidth="0" maxWidth="Infinity"
                              styleClass="portal-chart" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis tickLabelFill="#A5A8B0"/></xAxis>
                        <yAxis><NumberAxis   tickLabelFill="#A5A8B0"/></yAxis>
                    </BarChart>
                </VBox>
                <VBox spacing="12" minWidth="300" maxWidth="Infinity"
                      styleClass="chart-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <Label text="LEAVE SUMMARY" styleClass="section-title"/>
                    <VBox fx:id="leaveSummaryList" spacing="9" styleClass="leave-summary-list" VBox.vgrow="ALWAYS"/>
                </VBox>
            </GridPane>

        </VBox>
    </HBox>

    <GridPane hgap="14" maxWidth="Infinity" styleClass="dashboard-bottom-row">
        <columnConstraints>
            <ColumnConstraints percentWidth="33" minWidth="300" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="33" minWidth="320" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="34" minWidth="320" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox spacing="12" styleClass="bottom-card, dashboard-bottom-card, upcoming-holiday-card"
              minWidth="300" maxWidth="Infinity"
              GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
            <Label text="UPCOMING HOLIDAY" styleClass="metric-label"/>
            <VBox spacing="6" styleClass="bottom-card-content" VBox.vgrow="ALWAYS">
                <Label text="June 12, 2026" maxWidth="Infinity" styleClass="bottom-value"/>
                <Label text="Independence Day" wrapText="true" styleClass="muted-text"/>
            </VBox>
        </VBox>
        <VBox spacing="12" styleClass="bottom-card, dashboard-bottom-card, recent-report-card"
              minWidth="320" maxWidth="Infinity"
              GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
            <Label text="RECENT HR REPORT" styleClass="metric-label"/>
            <VBox spacing="8" styleClass="bottom-card-content" VBox.vgrow="ALWAYS">
                <Label text="No report available yet" styleClass="bottom-value"/>
                <Label text="HR reports will be available here once enabled." wrapText="true" styleClass="muted-text"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button text="View Report" disable="true" maxWidth="Infinity" styleClass="small-pill-button"/>
            </VBox>
        </VBox>
        <VBox spacing="12" styleClass="bottom-card, dashboard-bottom-card, announcements-card"
              minWidth="320" maxWidth="Infinity"
              GridPane.columnIndex="2" GridPane.hgrow="ALWAYS">
            <Label text="ANNOUNCEMENTS" styleClass="metric-label"/>
            <VBox spacing="8" styleClass="bottom-card-content" VBox.vgrow="ALWAYS">
                <Label text="Company Town Hall Meeting" styleClass="bottom-value"/>
                <Label text="All employees are encouraged to attend. More details will be sent via email."
                       wrapText="true" styleClass="muted-text"/>
            </VBox>
        </VBox>
    </GridPane>

</VBox>
