<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.it.account.ITUserAccountController">

    <HBox spacing="14">
        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL ACCOUNTS" styleClass="metric-label"/>
            <Label fx:id="totalAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="All user accounts" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE ACCOUNTS" styleClass="metric-label"/>
            <Label fx:id="activeAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Unlocked active users" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="LOCKED ACCOUNTS" styleClass="metric-label"/>
            <Label fx:id="lockedAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Temporarily locked" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="DISABLED ACCOUNTS" styleClass="metric-label"/>
            <Label fx:id="disabledAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Disabled accounts" styleClass="muted-text"/>
        </VBox>
    </HBox>

    <VBox spacing="12" styleClass="content-card">
        <HBox alignment="BOTTOM_LEFT" spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Search" styleClass="metric-label"/>
                <TextField fx:id="searchField"
                           promptText="Search by employee name, company email, role, or status"
                           maxWidth="Infinity"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Status" styleClass="metric-label"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="170" styleClass="input-field"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="primary-button"/>
        </HBox>

        <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

    <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          styleClass="content-card, attendance-history-card"
          VBox.vgrow="ALWAYS">

        <VBox spacing="4">
            <Label text="User Accounts" styleClass="section-title"/>
            <Label text="List of all employee user accounts" styleClass="note-text"/>
        </VBox>

        <Region prefHeight="16"/>

        <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                   styleClass="payroll-table, attendance-table">
            <columns>
                <TableColumn fx:id="employeeIdColumn"  text="Employee ID"   prefWidth="95"  minWidth="70"/>
                <TableColumn fx:id="fullNameColumn"    text="Full Name"     prefWidth="150" minWidth="110"/>
                <TableColumn fx:id="companyEmailColumn" text="Company Email" prefWidth="210" minWidth="140"/>
                <TableColumn fx:id="rolesColumn"       text="Roles"         prefWidth="150" minWidth="100"/>
                <TableColumn fx:id="currentRoleColumn" text="Current Role"  prefWidth="110" minWidth="80"/>
                <TableColumn fx:id="statusColumn"      text="Status"        prefWidth="95"  minWidth="70"/>
                <TableColumn fx:id="lastLoginColumn"   text="Last Login"    prefWidth="165" minWidth="120"/>
                <TableColumn fx:id="actionsColumn"     text="Actions"       prefWidth="160" minWidth="120"/>
            </columns>
            <placeholder>
                <Label text="No user accounts found." styleClass="note-text"/>
            </placeholder>
        </TableView>

        <Region prefHeight="14"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="accountsPrevButton" text="&#8592; Previous" onAction="#handleAccountsPrevPage"
                    styleClass="secondary-button"/>
            <Label fx:id="accountsPageLabel" text="Page 1 of 1" styleClass="note-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="accountsRecordInfoLabel" text="" styleClass="note-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="accountsNextButton" text="Next &#8594;" onAction="#handleAccountsNextPage"
                    styleClass="secondary-button"/>
        </HBox>

    </VBox>

</VBox>