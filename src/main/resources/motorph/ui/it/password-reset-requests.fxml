<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.it.reset.PasswordResetRequestController">

    <VBox spacing="4">
        <Label text="Password Reset Requests" styleClass="section-title"/>
        <Label text="Review and process employee password reset requests" styleClass="muted-text"/>
    </VBox>

    <TilePane hgap="14" vgap="14" prefColumns="4" tileAlignment="TOP_LEFT">
        <VBox spacing="6" prefWidth="260" minHeight="105" styleClass="metric-card">
            <Label text="PENDING REQUESTS" styleClass="metric-label"/>
            <Label fx:id="pendingRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Awaiting your action" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" prefWidth="260" minHeight="105" styleClass="metric-card">
            <Label text="COMPLETED REQUESTS" styleClass="metric-label"/>
            <Label fx:id="completedRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Successfully processed" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" prefWidth="260" minHeight="105" styleClass="metric-card">
            <Label text="CANCELLED REQUESTS" styleClass="metric-label"/>
            <Label fx:id="cancelledRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Cancelled by IT" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" prefWidth="260" minHeight="105" styleClass="metric-card">
            <Label text="TOTAL REQUESTS" styleClass="metric-label"/>
            <Label fx:id="totalRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="All time requests" styleClass="muted-text"/>
        </VBox>
    </TilePane>

    <VBox spacing="12" styleClass="content-card">
        <HBox alignment="BOTTOM_LEFT" spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Search" styleClass="metric-label"/>
                <TextField fx:id="searchField"
                           promptText="Search by employee name, company email, or request ID"
                           maxWidth="Infinity"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Status" styleClass="metric-label"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="170" styleClass="input-field"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="primary-button"/>
        </HBox>

        <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

    <VBox spacing="10" styleClass="content-card" VBox.vgrow="ALWAYS">
        <Label text="Requests List" styleClass="section-subtitle"/>

        <TableView fx:id="requestsTable" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="account-table">
            <columns>
                <TableColumn fx:id="requestIdColumn" text="Request ID" prefWidth="90"/>
                <TableColumn fx:id="employeeColumn" text="Employee" prefWidth="150"/>
                <TableColumn fx:id="companyEmailColumn" text="Company Email" prefWidth="210"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                <TableColumn fx:id="requestedAtColumn" text="Requested At" prefWidth="165"/>
                <TableColumn fx:id="resolvedByColumn" text="Resolved By" prefWidth="120"/>
                <TableColumn fx:id="completedAtColumn" text="Completed At" prefWidth="165"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="recordCountLabel" text="Showing 0 to 0 of 0 requests" styleClass="muted-text"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

</VBox>
