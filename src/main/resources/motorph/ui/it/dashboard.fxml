<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.it.ITDashboardController">

    <!-- ── Row 1: Account metric cards ───────────────────────────── -->
    <HBox spacing="14">

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE ACCOUNTS"  styleClass="metric-label"/>
            <Label fx:id="activeAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Unlocked active users" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="LOCKED ACCOUNTS"  styleClass="metric-label"/>
            <Label fx:id="lockedAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Accounts locked" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="DISABLED ACCOUNTS" styleClass="metric-label"/>
            <Label fx:id="disabledAccountsLabel" text="0" styleClass="metric-value"/>
            <Label text="Inactive accounts" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="PENDING RESETS"   styleClass="metric-label"/>
            <Label fx:id="pendingResetRequestsLabel" text="0" styleClass="metric-value"/>
            <Label text="Password reset requests" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 2: Support tickets · Login activity · System status ── -->
    <HBox spacing="14">

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="OPEN TICKETS"  styleClass="metric-label"/>
            <Label fx:id="openTicketsLabel" text="0" styleClass="metric-value"/>
            <Label text="Tickets waiting for action" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="12" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="LOGIN ACTIVITY (TODAY)" styleClass="section-title"/>
            <HBox spacing="32">
                <VBox spacing="4">
                    <Label fx:id="successLoginsLabel" text="0" styleClass="stat-success"/>
                    <Label text="Successful logins" styleClass="positive-text"/>
                </VBox>
                <VBox spacing="4">
                    <Label fx:id="failedLoginsLabel"  text="0" styleClass="stat-danger"/>
                    <Label text="Failed logins" styleClass="muted-text"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="SYSTEM STATUS" styleClass="section-title"/>
            <Label text="All Systems Operational" styleClass="system-ok-text"/>
            <Label text="All services are running normally" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 3: Summary tables ─────────────────────────────────── -->
    <HBox spacing="14">

        <!-- Pending Password Reset Requests -->
        <VBox spacing="10" styleClass="chart-card" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">
                <Label text="PENDING PASSWORD RESET REQUESTS" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="View All" onAction="#viewAllResets" styleClass="small-pill-button"/>
            </HBox>

            <!-- Table header -->
            <HBox styleClass="table-header-row" spacing="0">
                <Label text="REQUEST ID"   styleClass="table-head" prefWidth="90"/>
                <Label text="ACCOUNT"      styleClass="table-head" prefWidth="100"/>
                <Label text="STATUS"       styleClass="table-head" prefWidth="90"/>
                <Label text="REQUESTED ON" styleClass="table-head" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Populated by ITDashboardController -->
            <VBox fx:id="pendingResetRows" spacing="0"/>

        </VBox>

        <!-- Recent Support Tickets (no Priority column) -->
        <VBox spacing="10" styleClass="chart-card" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">
                <Label text="RECENT SUPPORT TICKETS" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="View All" onAction="#viewAllTickets" styleClass="small-pill-button"/>
            </HBox>

            <!-- Table header -->
            <HBox styleClass="table-header-row" spacing="0">
                <Label text="TICKET ID"    styleClass="table-head" prefWidth="80"/>
                <Label text="CATEGORY"     styleClass="table-head" prefWidth="110"/>
                <Label text="SUBJECT"      styleClass="table-head" HBox.hgrow="ALWAYS"/>
                <Label text="STATUS"       styleClass="table-head" prefWidth="75"/>
                <Label text="DATE CREATED" styleClass="table-head" prefWidth="140"/>
            </HBox>

            <!-- Populated by ITDashboardController -->
            <VBox fx:id="recentTicketsRows" spacing="0"/>

        </VBox>

    </HBox>

</VBox>