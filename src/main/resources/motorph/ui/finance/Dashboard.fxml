<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      fillWidth="true"
      maxWidth="Infinity"
      minWidth="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.finance.FinanceDashboardController">

    <!-- ── Row 1: KPI cards ─────────────────────────────────────── -->
    <HBox spacing="14">

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL EMPLOYEES" styleClass="metric-label"/>
            <Label fx:id="totalEmployeesLabel" text="0" styleClass="metric-value"/>
            <Label text="Across generated payroll reports" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL GROSS PAY" styleClass="metric-label"/>
            <Label fx:id="totalGrossPayLabel" text="₱0.00" styleClass="financial-value"/>
            <Label text="Across generated payroll reports" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL DEDUCTIONS" styleClass="metric-label"/>
            <Label fx:id="totalDeductionsLabel" text="₱0.00" styleClass="financial-value"/>
            <Label text="Across generated payroll reports" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="PAYROLL MONTH" styleClass="metric-label"/>
            <Label fx:id="payrollMonthLabel" text="—" styleClass="metric-value"/>
            <Label text="Current payroll period" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 2: Net pay · Most recent pay date ─────────────────── -->
    <HBox spacing="14">

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL NET PAY" styleClass="metric-label"/>
            <Label fx:id="totalNetPayLabel" text="₱0.00" styleClass="financial-value"/>
            <Label text="Across generated payroll reports" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="MOST RECENT PAY DATE" styleClass="metric-label"/>
            <Label fx:id="mostRecentPayDateLabel" text="—" styleClass="metric-value"/>
            <Label text="Latest completed payroll run" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 3: Net pay trend (≈60%) · Deduction breakdown (≈40%) ─ -->
    <GridPane hgap="14" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="60" minWidth="420" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="40" minWidth="320" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Net pay by pay period -->
        <VBox spacing="10" minWidth="420" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="NET PAY BY PAY PERIOD" styleClass="section-title"/>
            <LineChart fx:id="netPayChart" animated="false" legendVisible="false"
                       createSymbols="true" minWidth="0" maxWidth="Infinity"
                       styleClass="portal-chart" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis fx:id="netPayPeriodAxis" tickLabelFill="#A5A8B0"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="netPayAmountAxis" tickLabelFill="#A5A8B0" forceZeroInRange="false"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- Deduction breakdown donut -->
        <VBox spacing="10" minWidth="320" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="DEDUCTION BREAKDOWN" styleClass="section-title"/>
            <PieChart fx:id="deductionChart" animated="false" legendVisible="true"
                      labelsVisible="false" minWidth="0" maxWidth="Infinity"
                      styleClass="portal-chart" VBox.vgrow="ALWAYS"/>
        </VBox>

    </GridPane>

    <!-- ── Row 4: Payroll cost by department (≈60%) · Report summary (≈40%) ─ -->
    <GridPane hgap="14" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="60" minWidth="420" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="40" minWidth="320" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Payroll cost by department (horizontal bars) -->
        <VBox spacing="10" minWidth="420" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="PAYROLL COST BY DEPARTMENT" styleClass="section-title"/>
            <BarChart fx:id="departmentCostChart" animated="false" legendVisible="false"
                      minWidth="0" maxWidth="Infinity"
                      styleClass="portal-chart" VBox.vgrow="ALWAYS">
                <xAxis>
                    <NumberAxis fx:id="departmentAmountAxis" tickLabelFill="#A5A8B0" side="BOTTOM"/>
                </xAxis>
                <yAxis>
                    <CategoryAxis fx:id="departmentNameAxis" tickLabelFill="#A5A8B0" side="LEFT"/>
                </yAxis>
            </BarChart>
        </VBox>

        <!-- Report summary -->
        <VBox spacing="12" minWidth="320" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="REPORT SUMMARY" styleClass="section-title"/>

            <Label fx:id="summaryEmployeesLabel" text="0 employees included"
                   wrapText="true" styleClass="data-line"/>
            <Label fx:id="summaryCutoffsLabel" text="0 payroll cutoffs summarized"
                   wrapText="true" styleClass="data-line"/>
            <Label fx:id="summaryValidationLabel" text="All report validations passed"
                   wrapText="true" styleClass="data-line"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Open Payroll Summary" onAction="#openPayrollManagement"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <Button text="Open Payslip Report" onAction="#openReports"
                    maxWidth="Infinity" minHeight="44" styleClass="secondary-button"/>
        </VBox>

    </GridPane>

</VBox>
