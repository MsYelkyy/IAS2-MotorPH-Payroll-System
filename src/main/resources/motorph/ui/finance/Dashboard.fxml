<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      fillWidth="true"
      maxWidth="Infinity"
      minWidth="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.finance.FinanceDashboardController">

    <!-- ── Row 1: Payrun metric cards (no icons) ─────────────────── -->
    <HBox spacing="14">

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="PENDING PAYRUNS" styleClass="metric-label"/>
            <Label fx:id="pendingPayrunsLabel" text="0" styleClass="metric-value"/>
            <Label text="Awaiting generation" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="READY EMPLOYEES" styleClass="metric-label"/>
            <Label fx:id="readyEmployeesLabel" text="0" styleClass="metric-value"/>
            <Label text="Eligible for payroll" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="COMPLETED PAYRUNS" styleClass="metric-label"/>
            <Label fx:id="completedPayrunsLabel" text="0" styleClass="metric-value"/>
            <Label text="Payroll generated" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label text="UPCOMING PAY DATE" styleClass="metric-label"/>
            <Label fx:id="upcomingPayDateLabel" text="—" styleClass="metric-value"/>
            <Label text="Next pending payrun" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 2: Employees paid · Total net pay ─────────────────── -->
    <HBox spacing="14">

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="EMPLOYEES PAID" styleClass="metric-label"/>
            <Label fx:id="employeesPaidLabel" text="0" styleClass="metric-value"/>
            <Label text="Across completed payruns" styleClass="muted-text"/>
        </VBox>

        <VBox spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL NET PAY" styleClass="metric-label"/>
            <Label fx:id="totalNetPayLabel" text="₱0.00" styleClass="financial-value"/>
            <Label text="Across completed payruns" styleClass="muted-text"/>
        </VBox>

    </HBox>

    <!-- ── Row 3: Net-pay trend chart (≈70%) · Payroll summary (≈30%) ─ -->
    <GridPane hgap="14" maxWidth="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="70" minWidth="420" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="30" minWidth="280" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Net-pay trend chart -->
        <VBox spacing="10" minWidth="420" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="LATEST PAYRUN NET PAY" styleClass="section-title"/>
            <LineChart fx:id="netPayChart" animated="false" legendVisible="false"
                       createSymbols="true" minWidth="0" maxWidth="Infinity"
                       styleClass="portal-chart" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis fx:id="netPayPeriodAxis" tickLabelFill="#A5A8B0"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="netPayAmountAxis" tickLabelFill="#A5A8B0" forceZeroInRange="false"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- Payroll summary -->
        <VBox spacing="12" minWidth="280" maxWidth="Infinity" maxHeight="Infinity"
              styleClass="chart-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <Label text="PAYROLL SUMMARY" styleClass="section-title"/>

            <VBox spacing="4">
                <Label text="TOTAL NET PAY" styleClass="metric-label"/>
                <Label fx:id="summaryNetPayLabel" text="₱0.00" styleClass="summary-net-value"/>
            </VBox>

            <Label fx:id="summaryDescriptionLabel"
                   text="No completed payruns yet."
                   wrapText="true" styleClass="muted-text"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Open Payroll Management" onAction="#openPayrollManagement"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <Button text="Open Reports" onAction="#openReports"
                    maxWidth="Infinity" minHeight="44" styleClass="secondary-button"/>
        </VBox>

    </GridPane>

</VBox>
