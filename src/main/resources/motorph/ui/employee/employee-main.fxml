<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.employee.EmployeeMainController"
           stylesheets="@../../../css/core/base.css, @../../../css/core/tokens.css, @../../../css/themes/dark.css, @../../../css/themes/light.css, @../../../css/core/feedback.css, @../../../css/core/typography.css, @../../../css/modules/shared/shared-components.css, @../../../css/modules/shared/support-ticket.css, @../../../css/modules/employee/dashboard.css, @../../../css/modules/employee/profile.css, @../../../css/modules/employee/attendance.css, @../../../css/modules/employee/leave.css, @../../../css/modules/employee/payslip.css, @../../../css/core/utilities.css">

    <BorderPane styleClass="app-shell">

        <!-- LEFT: Sidebar -->
        <left>
            <VBox spacing="10" styleClass="sidebar">

                <!-- Sidebar brand mark -->
                <VBox spacing="2" styleClass="sidebar-brand">
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="Motor" styleClass="sidebar-brand-motor"/>
                        <Label text="PH"    styleClass="sidebar-brand-ph"/>
                    </HBox>
                    <Label text="PAYROLL MANAGEMENT SYSTEM" styleClass="sidebar-brand-system"/>
                </VBox>

                <Separator/>

                <!-- Navigation -->
                <Button fx:id="dashboardNavButton"  text="Dashboard"         onAction="#showDashboard"  maxWidth="Infinity" styleClass="nav-button, selected-nav"/>
                <Button fx:id="profileNavButton"    text="Profile"            onAction="#showProfile"    maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="attendanceNavButton"  text="Attendance"         onAction="#showAttendance" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="leaveNavButton"       text="Leave Requests"     onAction="#showLeave"      maxWidth="Infinity" styleClass="nav-button"/>

                <Button fx:id="payslipNavButton" text="Payslip / Payroll"
                        onAction="#showPayslip"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="supportTicketsNavButton" text="Support Tickets"
                        onAction="#showSupportTickets"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="settingsNavButton" text="Account Settings"
                        onAction="#showSettings"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Employee identity card -->
                <VBox spacing="6" styleClass="sidebar-card">
                    <Label text="LOGGED IN AS" styleClass="sidebar-card-kicker"/>
                    <Label fx:id="dashboardEmployeeNameLabel" text="—" wrapText="true" styleClass="sidebar-card-title"/>
                    <Label fx:id="dashboardEmployeeRoleLabel" text="EMPLOYEE"           styleClass="sidebar-card-copy"/>
                </VBox>

                <Button fx:id="switchRoleButton"
                        text="Switch Role"
                        onAction="#handleSwitchRole"
                        visible="false"
                        managed="false"
                        maxWidth="Infinity"
                        styleClass="secondary-button"/>

                <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="danger-outline-button"/>
            </VBox>
        </left>

        <!-- CENTER: Main workspace -->
        <center>
            <VBox styleClass="app-main">

                <!-- Topbar -->
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
                    <VBox spacing="2">
                        <Label fx:id="pageTitleLabel"    text="Dashboard"          styleClass="page-title"/>
                        <Label fx:id="pageSubtitleLabel" text="EMPLOYEE WORKSPACE" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Active Session" styleClass="status-pill success-pill"/>
                    <HBox fx:id="globalControlsHostApp" alignment="CENTER_RIGHT" spacing="6" HBox.hgrow="NEVER"/>
                </HBox>

                <!-- Scrollable content area -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                            styleClass="workspace-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane styleClass="content-area">
                            <fx:include fx:id="dashboardView"  source="Dashboard.fxml"/>
                            <fx:include fx:id="profileView"    source="Profile.fxml"    visible="false" managed="false"/>
                            <fx:include fx:id="attendanceView" source="Attendance.fxml" visible="false" managed="false"/>
                            <fx:include fx:id="leaveView"      source="Leave.fxml"      visible="false" managed="false"/>
                            <fx:include fx:id="payslipView"
                                        source="Payslip.fxml"
                                        visible="false"
                                        managed="false"/>

                            <fx:include fx:id="supportTicketsView"
                                        source="SupportTickets.fxml"
                                        visible="false"
                                        managed="false"/>

                            <fx:include fx:id="settingsView"
                                        source="Settings.fxml"
                                        visible="false"
                                        managed="false"/>
                        </StackPane>
                    </content>
                </ScrollPane>

                <!-- Footer bar -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="footerbar">
                    <Label fx:id="appMessageLabel" text="Welcome to your employee workspace." styleClass="success-message"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>
        </center>

    </BorderPane>

    <!-- Sliding side panel -->
    <VBox fx:id="sidePanel" visible="false" managed="false"
          styleClass="side-panel" StackPane.alignment="TOP_RIGHT">
        <VBox styleClass="side-panel-content">
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label text="Options" styleClass="side-panel-title"/>
                <Button text="✕" onAction="#toggleSidePanel" styleClass="side-panel-close"/>
            </HBox>
            <Separator/>
            <Button text="Profile"          onAction="#showProfile"   styleClass="side-panel-item"/>
            <Button text="Notifications"    onAction="#showDashboard" styleClass="side-panel-item"/>
            <Button text="Help"             onAction="#showDashboard" styleClass="side-panel-item"/>
            <Separator/>
            <Button text="Account Settings" onAction="#showSettings"  styleClass="side-panel-item"/>
        </VBox>
    </VBox>

</StackPane>
