<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Shared Reports module (role-neutral). Consumed by Admin, IT, and future
  HR/Finance shells. Reuses ReportsController — no duplicate backend.
  JasperReports export is not yet implemented; a notice banner communicates this.
-->
<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.reports.ReportsController"
      VBox.vgrow="ALWAYS">

    <!-- Availability notice -->
    <VBox styleClass="content-card" spacing="6">
        <Label text="Report generation notice" styleClass="field-label"/>
        <Label text="Report export (PDF / JasperReports) is not yet available. Use the Generate Preview button to create a reference entry. No file will be produced."
               styleClass="muted-text" wrapText="true"/>
    </VBox>

    <!-- Filters -->
    <VBox spacing="16" styleClass="content-card">
        <Label text="Report Filters" styleClass="section-title"/>

        <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Report Type" styleClass="field-label"/>
                <ComboBox fx:id="reportTypeCombo" promptText="Report Type"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Department" styleClass="field-label"/>
                <ComboBox fx:id="departmentFilterCombo" promptText="Department"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Employee" styleClass="field-label"/>
                <ComboBox fx:id="employeeFilterCombo" promptText="Employee"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Date Range" styleClass="field-label"/>
                <ComboBox fx:id="dateRangeCombo" promptText="Date Range"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <HBox spacing="14" alignment="BOTTOM_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusFilterCombo" promptText="Status"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Group By" styleClass="field-label"/>
                <ComboBox fx:id="groupByCombo" promptText="Group By"
                          styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="From" styleClass="field-label"/>
                <DatePicker fx:id="dateFromPicker" promptText="Date From"
                            styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="To" styleClass="field-label"/>
                <DatePicker fx:id="dateToPicker" promptText="Date To"
                            styleClass="input-field" maxWidth="Infinity"/>
            </VBox>
            <Button text="Generate Preview" onAction="#handleGenerate"
                    styleClass="primary-button" prefWidth="210"/>
        </HBox>
    </VBox>

    <!-- Preview table -->
    <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
          styleClass="content-card, attendance-history-card"
          VBox.vgrow="ALWAYS">

        <VBox spacing="4">
            <Label text="Preview Entries" styleClass="section-title"/>
            <Label fx:id="moduleMessageLabel" wrapText="true" styleClass="note-text"/>
        </VBox>

        <Region prefHeight="16"/>

        <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                   styleClass="payroll-table, attendance-table">
            <columns>
                <TableColumn fx:id="reportNameColumn"   text="Report Name"   prefWidth="260" minWidth="190"/>
                <TableColumn fx:id="reportTypeColumn"   text="Report Type"   prefWidth="170" minWidth="130"/>
                <TableColumn fx:id="departmentColumn"   text="Department"    prefWidth="170" minWidth="130"/>
                <TableColumn fx:id="dateRangeColumn"    text="Date Range"    prefWidth="210" minWidth="160"/>
                <TableColumn fx:id="generatedByColumn"  text="Generated By"  prefWidth="140" minWidth="110"/>
                <TableColumn fx:id="generatedAtColumn"  text="Generated At"  prefWidth="170" minWidth="130"/>
                <TableColumn fx:id="actionColumn"       text="Actions"       prefWidth="110" minWidth="90"/>
            </columns>
            <placeholder>
                <Label text="No preview entries yet. Select filters and click Generate Preview." styleClass="note-text"/>
            </placeholder>
        </TableView>

        <Region prefHeight="14"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="reportsPrevButton" text="&#8592; Previous" onAction="#handleReportsPrevPage"
                    styleClass="secondary-button"/>
            <Label fx:id="reportsPageLabel" text="Page 1 of 1" styleClass="note-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="reportsRecordInfoLabel" text="" styleClass="note-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="reportsNextButton" text="Next &#8594;" onAction="#handleReportsNextPage"
                    styleClass="secondary-button"/>
        </HBox>

    </VBox>

</VBox>
