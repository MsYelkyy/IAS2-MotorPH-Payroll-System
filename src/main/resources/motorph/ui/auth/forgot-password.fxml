<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!--
    Single-step card: employee submits their company email to request a
    password reset. IT reviews and approves the request, then emails a
    temporary password to the employee's registered personal email.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.ForgotPasswordController">

    <!-- STEP 1: Email entry -->
    <VBox fx:id="forgotEmailCard" spacing="20" styleClass="form-card">
        <VBox spacing="4">
            <Label text="Reset Password"                                           styleClass="form-heading"/>
            <Label text="Enter your email to submit a password reset request to IT."
                   wrapText="true"                                                 styleClass="form-subheading"/>
        </VBox>
        <VBox spacing="7">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="resetEmailField" promptText="name@motorph.com" styleClass="input-field"/>
        </VBox>
        <Button text="Submit Request" onAction="#handleSubmitRequest" maxWidth="Infinity" styleClass="signin-button"/>
        <Button text="← Back to Login" onAction="#backToLogin"        maxWidth="Infinity" styleClass="form-back-button"/>
        <Label fx:id="forgotEmailMessageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

</VBox>
