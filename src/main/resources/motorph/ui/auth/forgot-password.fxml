<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!--
    Root VBox contains three step-cards; ForgotPasswordController manages
    which step is visible/managed at any time.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.ForgotPasswordController">

    <!-- STEP 1: Email entry -->
    <VBox fx:id="forgotEmailCard" spacing="20" styleClass="form-card">
        <VBox spacing="4">
            <Label text="Reset Password"                             styleClass="form-heading"/>
            <Label text="Enter your email to receive a reset OTP."
                   wrapText="true"                                   styleClass="form-subheading"/>
        </VBox>
        <VBox spacing="7">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="resetEmailField" promptText="name@motorph.com" styleClass="input-field"/>
        </VBox>
        <Button text="Send Reset OTP"  onAction="#handleSendResetOtp" maxWidth="Infinity" styleClass="signin-button"/>
        <Button text="← Back to Login" onAction="#backToLogin"        maxWidth="Infinity" styleClass="form-back-button"/>
        <Label fx:id="forgotEmailMessageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

    <!-- STEP 2: OTP verification -->
    <VBox fx:id="forgotOtpCard" spacing="20" visible="false" managed="false" styleClass="form-card">
        <VBox spacing="4">
            <Label text="Verify Reset OTP"                                                         styleClass="form-heading"/>
            <Label text="Enter the reset code sent to your registered email address."
                   wrapText="true"                                                                 styleClass="form-subheading"/>
        </VBox>
        <VBox spacing="7">
            <Label text="OTP Code" styleClass="field-label"/>
            <TextField fx:id="resetOtpField" promptText="6-digit code" styleClass="input-field"/>
        </VBox>
        <Button text="Verify Reset OTP" onAction="#handleVerifyResetOtp" maxWidth="Infinity" styleClass="signin-button"/>
        <Button text="← Back to Email"  onAction="#backToEmailStep"      maxWidth="Infinity" styleClass="form-back-button"/>
        <Label fx:id="forgotOtpMessageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

    <!-- STEP 3: New password entry -->
    <VBox fx:id="forgotNewPasswordCard" spacing="20" visible="false" managed="false" styleClass="form-card">
        <VBox spacing="4">
            <Label text="Create New Password"            styleClass="form-heading"/>
            <Label text="Use at least 8 characters."
                   wrapText="true"                       styleClass="form-subheading"/>
        </VBox>
        <VBox spacing="7">
            <Label text="New Password" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField" promptText="New password" styleClass="input-field"/>
        </VBox>
        <VBox spacing="7">
            <Label text="Confirm Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" styleClass="input-field"/>
        </VBox>
        <Button text="Update Password" onAction="#handleCompleteReset" maxWidth="Infinity" styleClass="signin-button"/>
        <Button text="← Back to Login" onAction="#backToLogin"         maxWidth="Infinity" styleClass="form-back-button"/>
        <Label fx:id="forgotNewPasswordMessageLabel" wrapText="true" styleClass="message-label"/>
    </VBox>

</VBox>
