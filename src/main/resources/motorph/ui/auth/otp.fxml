<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="form-card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.auth.OtpController">

    <VBox spacing="4">
        <Label text="Verify OTP"                                                               styleClass="form-heading"/>
        <Label text="Enter the verification code sent to your registered email address."
               wrapText="true"                                                                 styleClass="form-subheading"/>
    </VBox>
    <VBox spacing="7">
        <Label text="OTP Code" styleClass="field-label"/>
        <TextField fx:id="otpField" promptText="6-digit code" styleClass="input-field"/>
    </VBox>
    <Button text="Verify and Continue" onAction="#handleOtpVerification" maxWidth="Infinity" styleClass="signin-button"/>
    <Button text="← Back to Login"     onAction="#backToLogin"           maxWidth="Infinity" styleClass="form-back-button"/>
    <Label fx:id="otpMessageLabel" wrapText="true" styleClass="message-label"/>

</VBox>
