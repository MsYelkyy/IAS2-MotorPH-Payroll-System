<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.admin.accesslogs.AdminAccessLogsController">

    <!-- Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Search by user ID, action, or details..."
                   styleClass="input-field" prefWidth="320" maxWidth="480" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="actionFilterCombo" promptText="Filter by action"
                  styleClass="input-field" prefWidth="210"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="logCountLabel" styleClass="muted-text"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text" wrapText="true" maxWidth="260"/>
    </HBox>

    <!-- Log table -->
    <VBox styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">

        <!-- Column headers -->
        <HBox styleClass="table-header-row" spacing="0" fillHeight="true">
            <Label text="USER ID"   styleClass="table-head" minWidth="60"  prefWidth="60"/>
            <Label text="ACTION"    styleClass="table-head" minWidth="190" prefWidth="190"/>
            <Label text="DETAILS"   styleClass="table-head" HBox.hgrow="ALWAYS"/>
            <Label text="TIMESTAMP" styleClass="table-head" minWidth="175" prefWidth="175"/>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="workspace-scroll" VBox.vgrow="ALWAYS" prefHeight="520">
            <content>
                <VBox fx:id="logRows"/>
            </content>
        </ScrollPane>
    </VBox>

</VBox>
