<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           styleClass="root-canvas"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="motorph.ui.admin.AdminMainController"
           stylesheets="@../../../css/motorph-theme.css, @../../../css/admin-ui.css, @../../../css/modules/it/user-access-logs.css, @../../../css/core/utilities.css">

    <BorderPane styleClass="app-shell">

        <!-- LEFT: Sidebar -->
        <left>
            <VBox spacing="10" styleClass="sidebar">

                <!-- Brand mark -->
                <VBox spacing="2" styleClass="sidebar-brand">
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="Motor" styleClass="sidebar-brand-motor"/>
                        <Label text="PH"    styleClass="sidebar-brand-ph"/>
                    </HBox>
                    <Label text="ADMIN CONTROL PANEL" styleClass="sidebar-brand-system"/>
                </VBox>

                <Separator/>

                <!-- Navigation -->
                <Button fx:id="dashboardNavButton"       text="Dashboard"            onAction="#showDashboard"       maxWidth="Infinity" styleClass="nav-button, selected-nav"/>
                <Button fx:id="employeesNavButton"       text="Employee Management"  onAction="#showEmployees"       maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="payrollNavButton"         text="Payroll"              onAction="#showPayroll"         maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="salaryNavButton"          text="Salary &amp; Benefits" onAction="#showSalary"         maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="reportsNavButton"         text="Reports"              onAction="#showReports"         maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="leaveOvertimeNavButton"   text="Leave &amp; Overtime" onAction="#showLeaveOvertime"   maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="userManagementNavButton"  text="User Management"      onAction="#showUserManagement"  maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="roleManagementNavButton"  text="Role Management"      onAction="#showRoleManagement"  maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="accessLogsNavButton"      text="Access Logs"          onAction="#showAccessLogs"      maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="databaseToolsNavButton"   text="Database Backup"      onAction="#showDatabaseTools"   maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="settingsNavButton"        text="Settings"             onAction="#showSettings"        maxWidth="Infinity" styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Employee identity card -->
                <VBox spacing="6" styleClass="sidebar-card">
                    <Label text="LOGGED IN AS" styleClass="sidebar-card-kicker"/>
                    <Label fx:id="employeeNameLabel" text="—" wrapText="true" styleClass="sidebar-card-title"/>
                    <Label fx:id="employeeRoleLabel" text="ADMIN"             styleClass="sidebar-card-copy"/>
                </VBox>

                <Button fx:id="switchRoleButton" text="Switch to Employee" onAction="#handleSwitchRole"
                        visible="false" managed="false" maxWidth="Infinity" styleClass="secondary-button"/>
                <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="danger-outline-button"/>

            </VBox>
        </left>

        <!-- CENTER: Main workspace -->
        <center>
            <VBox styleClass="app-main">

                <!-- Topbar -->
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
                    <VBox spacing="2">
                        <Label fx:id="pageTitleLabel"    text="Dashboard"          styleClass="page-title"/>
                        <Label fx:id="pageSubtitleLabel" text="ADMIN CONTROL PANEL" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Admin Session" styleClass="status-pill success-pill"/>
                    <HBox fx:id="globalControlsHost" alignment="CENTER_RIGHT" spacing="6" HBox.hgrow="NEVER"/>
                </HBox>

                <!-- Scrollable content area -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="workspace-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane styleClass="content-area">
                            <fx:include fx:id="dashboardView"  source="Dashboard.fxml"/>
                            <fx:include fx:id="employeeView"   source="employee/AdminEmployee.fxml" visible="false" managed="false"/>
                            <fx:include fx:id="payrollView"    source="payroll/AdminPayroll.fxml"  visible="false" managed="false"/>
                            <fx:include fx:id="salaryView"       source="salary/AdminSalary.fxml"                    visible="false" managed="false"/>
                            <fx:include fx:id="userAccountView" source="useraccount/AdminUserAccount.fxml"          visible="false" managed="false"/>
                            <fx:include fx:id="rolesView"       source="roles/AdminRoles.fxml"                      visible="false" managed="false"/>
                            <fx:include fx:id="accessLogsView"  source="../it/user-access-logs.fxml"                visible="false" managed="false"/>
                            <fx:include fx:id="reportsView"     source="reports/AdminReports.fxml"                  visible="false" managed="false"/>
                            <fx:include fx:id="leaveView"       source="leave/AdminLeave.fxml"                      visible="false" managed="false"/>
                            <fx:include fx:id="systemConfigView"    source="systemconfig/AdminSystemConfig.fxml"           visible="false" managed="false"/>
                            <fx:include fx:id="databaseToolsView"  source="databasetools/AdminDatabaseTools.fxml"          visible="false" managed="false"/>
                            <VBox fx:id="modulePlaceholder" alignment="CENTER" spacing="12"
                                  visible="false" managed="false">
                                <Label text="Coming Soon" styleClass="page-title"/>
                                <Label text="This module is under construction." styleClass="muted-text"/>
                            </VBox>
                        </StackPane>
                    </content>
                </ScrollPane>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="footerbar">
                    <Label fx:id="appMessageLabel" text="Admin Control Panel" styleClass="success-message"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>
        </center>

    </BorderPane>

</StackPane>
