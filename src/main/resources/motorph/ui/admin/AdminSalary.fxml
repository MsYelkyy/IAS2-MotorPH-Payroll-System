<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.admin.AdminSalaryController"
      VBox.vgrow="ALWAYS">

    <!-- Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar">
        <Button fx:id="backButton" text="Back" onAction="#handleBack"
                visible="false" managed="false" styleClass="secondary-button"/>
        <TextField fx:id="searchField" promptText="Search employee by name or ID"
                   styleClass="input-field" prefWidth="260"/>
        <ComboBox fx:id="statusFilterCombo" promptText="Status"
                  prefWidth="150" styleClass="input-field"/>
        <ComboBox fx:id="departmentFilterCombo" promptText="Department"
                  prefWidth="210" styleClass="input-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text"/>
        <Button fx:id="addSalaryButton" text="+ Add Salary" onAction="#handleAddSalary"
                visible="false" managed="false" styleClass="primary-button"/>
        <Button fx:id="editSalaryButton" text="Edit Dates" onAction="#handleEditSalary"
                visible="false" managed="false" styleClass="secondary-button"/>
        <Button fx:id="addBenefitButton" text="+ Add Benefit" onAction="#handleAddBenefit"
                visible="false" managed="false" styleClass="primary-button"/>
        <Button fx:id="endBenefitButton" text="End Benefit" onAction="#handleEndBenefit"
                visible="false" managed="false" styleClass="danger-outline-button"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <!-- Employee list -->
        <VBox fx:id="employeeListPanel" styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">
            <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                       styleClass="payroll-table">
                <columns>
                    <TableColumn fx:id="employeeIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                    <TableColumn fx:id="employeeNameColumn" text="Name" prefWidth="260" minWidth="180"/>
                    <TableColumn fx:id="employeeStatusColumn" text="Status" prefWidth="130" minWidth="100"/>
                    <TableColumn fx:id="employeeDepartmentColumn" text="Department" prefWidth="240" minWidth="170"/>
                    <TableColumn fx:id="employeeActionColumn" text="Actions" prefWidth="120" minWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No employees found." styleClass="muted-text"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Employee salary + benefits detail -->
        <VBox fx:id="employeeDetailPanel" visible="false" managed="false"
              spacing="16" VBox.vgrow="ALWAYS">

            <VBox styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">
                <Label text="Salary History" styleClass="section-title"
                       style="-fx-padding: 0 0 12 0;"/>
                <TableView fx:id="salaryTable" prefHeight="220" VBox.vgrow="ALWAYS"
                           styleClass="payroll-table">
                    <columns>
                        <TableColumn fx:id="salaryIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                        <TableColumn fx:id="salaryTypeColumn" text="Type" prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="salaryBasicColumn" text="Basic Salary" prefWidth="150" minWidth="120"/>
                        <TableColumn fx:id="salaryHourlyColumn" text="Hourly Rate" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="salaryStartColumn" text="Start Date" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="salaryEndColumn" text="End Date" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="salaryStatusColumn" text="Status" prefWidth="120" minWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No salary records found." styleClass="muted-text"/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">
                <Label text="Allowances &amp; Benefits" styleClass="section-title"
                       style="-fx-padding: 0 0 12 0;"/>
                <TableView fx:id="benefitTable" prefHeight="220" VBox.vgrow="ALWAYS"
                           styleClass="payroll-table">
                    <columns>
                        <TableColumn fx:id="benefitIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                        <TableColumn fx:id="benefitTypeColumn" text="Type" prefWidth="220" minWidth="160"/>
                        <TableColumn fx:id="benefitAmountColumn" text="Amount" prefWidth="150" minWidth="120"/>
                        <TableColumn fx:id="benefitStartColumn" text="Start Date" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="benefitEndColumn" text="End Date" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="benefitStatusColumn" text="Status" prefWidth="120" minWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No benefits assigned." styleClass="muted-text"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>

        <!-- Modal backdrop -->
        <Region fx:id="formBackdrop" visible="false" managed="false"
                style="-fx-background-color: rgba(0,0,0,0.72);"/>

        <!-- Salary form -->
        <VBox fx:id="salaryFormPanel" styleClass="content-card modal-panel"
              maxWidth="640" spacing="14" StackPane.alignment="TOP_CENTER"
              style="-fx-translate-y: 8;" visible="false" managed="false">
            <Label fx:id="salaryFormTitle" text="Add Salary Record" styleClass="section-title"/>
            <Label text="Fields apply to the selected employee and preserve payroll history."
                   styleClass="muted-text" wrapText="true"/>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SALARY TYPE" styleClass="field-label"/>
                    <ComboBox fx:id="salaryTypeCombo" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="BASIC SALARY" styleClass="field-label"/>
                    <TextField fx:id="basicSalaryField" promptText="e.g. 25000"
                               styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="HOURLY RATE" styleClass="field-label"/>
                    <TextField fx:id="hourlyRateField" promptText="e.g. 150.00"
                               styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="START DATE" styleClass="field-label"/>
                    <DatePicker fx:id="salaryStartDatePicker" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="END DATE" styleClass="field-label"/>
                <DatePicker fx:id="salaryEndDatePicker" styleClass="input-field" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="salaryFormErrorLabel" styleClass="error-message" wrapText="true"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#handleBack" styleClass="secondary-button"/>
                <Button text="Save" onAction="#saveSalaryRecord" styleClass="primary-button"/>
            </HBox>
        </VBox>

        <!-- Benefit form -->
        <VBox fx:id="benefitFormPanel" styleClass="content-card modal-panel"
              maxWidth="640" spacing="14" StackPane.alignment="TOP_CENTER"
              style="-fx-translate-y: 8;" visible="false" managed="false">
            <Label text="Add Benefit / Allowance" styleClass="section-title"/>
            <Label text="Benefit assignments apply monthly unless an end date is provided."
                   styleClass="muted-text" wrapText="true"/>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="BENEFIT TYPE" styleClass="field-label"/>
                    <ComboBox fx:id="benefitTypeCombo" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="AMOUNT" styleClass="field-label"/>
                    <TextField fx:id="benefitAmountField" promptText="Monthly amount"
                               styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="START DATE" styleClass="field-label"/>
                    <DatePicker fx:id="benefitStartDatePicker" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="END DATE" styleClass="field-label"/>
                    <DatePicker fx:id="benefitEndDatePicker" styleClass="input-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <Label fx:id="benefitFormErrorLabel" styleClass="error-message" wrapText="true"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#handleBack" styleClass="secondary-button"/>
                <Button text="Add Benefit" onAction="#saveBenefit" styleClass="primary-button"/>
            </HBox>
        </VBox>

    </StackPane>
</VBox>
