<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.admin.AdminDatabaseToolsController">

    <!-- Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="createBackupButton" text="Create Backup" onAction="#handleCreateBackup" styleClass="primary-button"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="backupCountLabel" styleClass="muted-text"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text" wrapText="true" maxWidth="300"/>
    </HBox>

    <!-- Backup table -->
    <VBox styleClass="content-card" spacing="0" VBox.vgrow="ALWAYS">

        <!-- Column headers -->
        <HBox styleClass="table-header-row" spacing="0" fillHeight="true">
            <Label text="FILE NAME"   styleClass="table-head" HBox.hgrow="ALWAYS" minWidth="320"/>
            <Label text="CREATED"     styleClass="table-head" minWidth="185" prefWidth="185"/>
            <Label text="SIZE"        styleClass="table-head" minWidth="90"  prefWidth="90"/>
            <Label text="ACTIONS"     styleClass="table-head" minWidth="220" prefWidth="220"/>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="workspace-scroll" VBox.vgrow="ALWAYS" prefHeight="520">
            <content>
                <VBox fx:id="backupRows"/>
            </content>
        </ScrollPane>

    </VBox>

</VBox>
