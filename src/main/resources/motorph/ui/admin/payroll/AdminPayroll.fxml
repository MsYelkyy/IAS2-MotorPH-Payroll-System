<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="motorph.ui.admin.payroll.AdminPayrollController"
      VBox.vgrow="ALWAYS">

    <HBox styleClass="module-toolbar" spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="backButton" text="Back" onAction="#handleBack"
                visible="false" managed="false"/>
        <ComboBox fx:id="periodFilterCombo" promptText="Period"
                  prefWidth="230" styleClass="input-field"/>
        <DatePicker fx:id="payDateFilterPicker" promptText="Pay Date"
                    prefWidth="160" styleClass="input-field"/>
        <ComboBox fx:id="typeFilterCombo" promptText="Type"
                  prefWidth="160" styleClass="input-field"/>
        <Button fx:id="clearPayrunFiltersButton" text="Clear"
                onAction="#clearPayrunFilters" styleClass="secondary-button"/>
        <TextField fx:id="employeeIdFilterField" promptText="Employee ID"
                   prefWidth="140" styleClass="input-field" visible="false" managed="false"/>
        <TextField fx:id="employeeFilterField" promptText="Employee"
                   prefWidth="240" styleClass="input-field" visible="false" managed="false"/>
        <Button fx:id="clearResultFiltersButton" text="Clear"
                onAction="#clearResultFilters" styleClass="secondary-button"
                visible="false" managed="false"/>
        <Label fx:id="moduleMessageLabel" styleClass="muted-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="generateOneButton" text="Generate for Employee"
                onAction="#handleGenerateForEmployee" visible="false" managed="false"
                styleClass="secondary-button"/>
        <Button fx:id="generateAllButton" text="Generate All"
                onAction="#handleGenerateAll" visible="false" managed="false"
                styleClass="primary-button"/>
        <Button fx:id="printButton" text="Print Payslip"
                onAction="#handlePrint" visible="false" managed="false"
                styleClass="secondary-button"/>
        <Button fx:id="newPayrunButton" text="+ New Payrun"
                onAction="#handleNewPayrun" styleClass="primary-button"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <VBox fx:id="payrunListPanel" styleClass="content-card" spacing="12">
            <TableView fx:id="payrunTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                       styleClass="payroll-table">
                <columns>
                    <TableColumn fx:id="payrunIdColumn" text="ID" prefWidth="70" minWidth="60"/>
                    <TableColumn fx:id="payrunPeriodColumn" text="Period" prefWidth="240" minWidth="180"/>
                    <TableColumn fx:id="payrunPayDateColumn" text="Pay Date" prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="payrunTypeColumn" text="Type" prefWidth="160" minWidth="130"/>
                    <TableColumn fx:id="payrunActionColumn" text="Actions" prefWidth="120" minWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No payroll data found." styleClass="muted-text"/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="payrunDetailPanel" visible="false" managed="false"
              styleClass="content-card" spacing="12">
            <Label fx:id="payrunInfoLabel" styleClass="muted-text"/>

            <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" maxHeight="Infinity"
                       styleClass="payroll-table">
                <columns>
                    <TableColumn fx:id="resultEmployeeIdColumn" text="Emp ID" prefWidth="90" minWidth="70"/>
                    <TableColumn fx:id="resultEmployeeColumn" text="Employee" prefWidth="230" minWidth="180"/>
                    <TableColumn fx:id="resultGrossPayColumn" text="Gross Pay" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="resultDeductionsColumn" text="Deductions" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="resultNetPayColumn" text="Net Pay" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="resultActionColumn" text="Actions" prefWidth="130" minWidth="110"/>
                </columns>
                <placeholder>
                    <Label text="No payroll results found." styleClass="muted-text"/>
                </placeholder>
            </TableView>
        </VBox>

        <VBox fx:id="payslipDetailPanel" visible="false" managed="false"
              styleClass="content-card" spacing="16">

            <HBox spacing="0">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="EMPLOYEE" styleClass="field-label"/>
                    <Label fx:id="slipNameLabel" styleClass="section-title"/>
                    <Label fx:id="slipPositionLabel" styleClass="muted-text"/>
                    <Label fx:id="slipSuperLabel" styleClass="muted-text"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="PAY PERIOD" styleClass="field-label"/>
                    <Label fx:id="slipPeriodLabel" styleClass="section-title"/>
                    <Label fx:id="slipPayDateLabel" styleClass="muted-text"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="GOVERNMENT NUMBERS" styleClass="field-label"/>
                    <Label fx:id="slipSssLabel" styleClass="muted-text"/>
                    <Label fx:id="slipPhilhLabel" styleClass="muted-text"/>
                    <Label fx:id="slipPagibigLabel" styleClass="muted-text"/>
                    <Label fx:id="slipTinLabel" styleClass="muted-text"/>
                </VBox>
            </HBox>

            <Separator/>

            <HBox spacing="32">
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 8; -fx-padding: 14;">
                    <Label text="EARNINGS" styleClass="section-label"/>
                    <HBox><Label text="Basic Pay" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipBasicPayLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Rice Subsidy" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipRiceLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Phone Allowance" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipPhoneLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Clothing Allowance" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipClothingLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <Separator style="-fx-opacity: 0.4;"/>
                    <HBox>
                        <Label text="Total Compensation" prefWidth="200" styleClass="field-label"/>
                        <Label fx:id="slipTotalCompLabel" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 8; -fx-padding: 14;">
                    <Label text="DEDUCTIONS" styleClass="section-label"/>
                    <HBox><Label text="SSS" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipSssDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="PhilHealth" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipPhDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Pag-IBIG" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipPagibigDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Withholding Tax" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipTaxDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Late" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipLateDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <HBox><Label text="Undertime" prefWidth="200" styleClass="muted-text"/><Label fx:id="slipUndertimeDedLabel" styleClass="data-line" HBox.hgrow="ALWAYS"/></HBox>
                    <Separator style="-fx-opacity: 0.4;"/>
                    <HBox>
                        <Label text="Total Deductions" prefWidth="200" styleClass="field-label"/>
                        <Label fx:id="slipTotalDedLabel" styleClass="field-label" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>

            <Separator/>

            <HBox alignment="CENTER_RIGHT" spacing="16"
                  style="-fx-background-color: rgba(59,130,246,0.08); -fx-background-radius: 8; -fx-padding: 14 18;">
                <Label text="NET PAY" styleClass="field-label"/>
                <Label fx:id="slipNetPayLabel" styleClass="metric-value"/>
            </HBox>
        </VBox>

        <Region fx:id="payrunFormBackdrop" visible="false" managed="false"
                style="-fx-background-color: rgba(0,0,0,0.72);"/>

        <VBox fx:id="payrunFormPanel" visible="false" managed="false"
              spacing="16" styleClass="content-card modal-panel"
              maxWidth="520" StackPane.alignment="TOP_CENTER" style="-fx-translate-y: 8;">
            <Label text="New Payrun" styleClass="section-title"/>
            <Label text="Create a payroll run for a pay period."
                   styleClass="muted-text" wrapText="true"/>

            <GridPane hgap="12" vgap="12">
                <Label text="START DATE" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="payrunStartDatePicker" styleClass="input-field" prefWidth="260"
                            GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="END DATE" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <DatePicker fx:id="payrunEndDatePicker" styleClass="input-field" prefWidth="260"
                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="PAY DATE" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="payrunPayDatePicker" styleClass="input-field" prefWidth="260"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="PAYROLL TYPE" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="payrunTypeCombo" styleClass="input-field" prefWidth="260"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <Label fx:id="payrunFormErrorLabel" styleClass="error-message" wrapText="true"/>

            <HBox spacing="10" styleClass="admin-form-actions">
                <Button text="Cancel" onAction="#hideNewPayrunForm"
                        styleClass="secondary-button admin-form-button"/>
                <Button text="Create" onAction="#saveNewPayrun"
                        styleClass="primary-button admin-form-button"/>
            </HBox>
        </VBox>

    </StackPane>

</VBox>
