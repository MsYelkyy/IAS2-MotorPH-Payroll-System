# Copy this file to .env (gitignored) and fill in real values for local development.
# Never commit real credentials or signing secrets.

MOTORPH_DB_HOST=localhost
MOTORPH_DB_PORT=3306
MOTORPH_DB_USER=motorph_backend
MOTORPH_DB_PASSWORD=change-me

# 32+ byte random secret, e.g. `openssl rand -base64 48`
MOTORPH_JWT_SECRET=change-me-to-a-long-random-value
MOTORPH_JWT_ACCESS_EXPIRY_MINUTES=15
MOTORPH_JWT_REFRESH_EXPIRY_MINUTES=1440
