<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="attendance_report" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-1111-4333-9444-abcd12345678">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="START_DATE" class="java.time.LocalDate"/>
    <parameter name="END_DATE" class="java.time.LocalDate"/>

    <field name="employeeId" class="java.lang.Integer"/>
