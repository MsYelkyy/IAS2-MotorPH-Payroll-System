    <field name="workDate" class="java.time.LocalDate"/>
    <field name="timeIn" class="java.time.LocalTime"/>
    <field name="timeOut" class="java.time.LocalTime"/>
    <field name="totalHoursWorked" class="java.lang.Double"/>
    <field name="attendanceStatus" class="java.lang.String"/>

    <variable name="recordCount" calculation="Count" class="java.lang.Integer">
        <expression><![CDATA[$F{employeeId}]]></expression>
    </variable>

    <title height="170">
